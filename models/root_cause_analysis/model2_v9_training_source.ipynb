    for feature in system_union[system]:

        base = feature.rsplit(
            "__",
            1
        )[0]

        matched_family = None

        for family in FAMILIES:

            if base.endswith(
                "_" + family
            ):

                matched_family = family
                break

        if matched_family:

            service = base[
                :-(len(matched_family) + 1)
            ]

            services.add(
                service
            )

    print(
        f"\n{system}: "
        f"{len(services)} services"
    )

    for service in sorted(services):

        print(
