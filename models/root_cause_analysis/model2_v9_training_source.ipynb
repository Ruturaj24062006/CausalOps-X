def scale_graph(graph):

    g = copy.deepcopy(graph)

    x_np = (
        g.x
        .detach()
        .cpu()
        .numpy()
    )

    scaled = scaler.transform(
        x_np
    )

    assert scaled.shape == x_np.shape
    assert scaled.shape[1] == 32
    assert np.isfinite(scaled).all()

    g.x = torch.tensor(
        scaled,
        dtype=torch.float32
    )

    return g


