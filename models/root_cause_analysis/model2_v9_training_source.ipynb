def find_system_split(obj):

    systems = [
        "Online Boutique",
        "Sock Shop",
        "Train Ticket",
    ]

    if isinstance(obj, dict):

        if all(system in obj for system in systems):
            return {
                system: obj[system]
                for system in systems
            }

        for value in obj.values():

            result = find_system_split(value)

            if result is not None:
                return result

    elif isinstance(obj, list):

        for value in obj:

            result = find_system_split(value)

            if result is not None:
                return result

    return None


split_by_system = find_system_split(split_manifest)

assert isinstance(
    split_by_system,
    dict
), "Could not recover exact Step 17B system-wise split."


def find_split_list(obj, possible_names):

    if isinstance(obj, dict):

        for key in possible_names:

            if key in obj and isinstance(
                obj[key],
                list
            ):
                return obj[key]

        for value in obj.values():

            result = find_split_list(
                value,
                possible_names
            )

            if result is not None:
                return result

    elif isinstance(obj, list):

        for value in obj:

            result = find_split_list(
                value,
                possible_names
            )

            if result is not None:
                return result

    return None


