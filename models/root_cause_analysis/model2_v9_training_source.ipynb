def find_system_split(obj):

    systems = [
        "Online Boutique",
        "Sock Shop",
        "Train Ticket",
    ]

    if isinstance(obj, dict):

        if all(
            system in obj
            for system in systems
        ):
            return {
                system: obj[system]
                for system in systems
            }

        for value in obj.values():

            result = find_system_split(
                value
            )

            if result is not None:
                return result

    elif isinstance(obj, list):

        for value in obj:

            result = find_system_split(
                value
            )

            if result is not None:
                return result

    return None


def find_split_list(obj, names):

    if isinstance(obj, dict):

        for name in names:

            if (
                name in obj
                and isinstance(
                    obj[name],
                    list
                )
            ):
                return obj[name]

        for value in obj.values():

            result = find_split_list(
                value,
                names
            )

            if result is not None:
                return result

    elif isinstance(obj, list):

        for value in obj:

            result = find_split_list(
                value,
                names
            )

            if result is not None:
                return result

    return None


