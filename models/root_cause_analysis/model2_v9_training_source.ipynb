def normalize_edges(edge_list):

    result = []

    if not isinstance(edge_list, list):
        return result

    for edge in edge_list:

        src = None
        dst = None

        if isinstance(edge, dict):

            for key in [
                "source",
                "src",
                "source_node",
                "parent",
                "parent_service",
            ]:

                if key in edge:
                    src = edge[key]
                    break

            for key in [
                "target",
                "dst",
                "target_node",
                "child",
                "child_service",
            ]:

                if key in edge:
                    dst = edge[key]
                    break

        elif isinstance(edge, (list, tuple)):

            if len(edge) >= 2:

                src = edge[0]
                dst = edge[1]

        if (
            isinstance(src, str)
            and
            isinstance(dst, str)
        ):

            result.append(
                (src, dst)
            )

    return result


def normalize_topology_container(container):

    normalized = {}

    # Dictionary keyed by case_id
    if isinstance(container, dict):

        for case_id, value in container.items():

            if not isinstance(case_id, str):
                continue

            if not isinstance(value, dict):
                continue

            edges = []

            for key in [
                "edges",
                "edge_list",
                "topology_edges",
                "relationships",
                "service_relationships",
            ]:

                if key in value:

                    edges = normalize_edges(
                        value[key]
                    )

                    break

            normalized[case_id] = {
                "edges": edges
            }

        return normalized

    # List of case records
    if isinstance(container, list):

        for record in container:

            if not isinstance(record, dict):
                continue

            case_id = None

            for key in [
                "case_id",
                "caseId",
                "case",
                "id",
            ]:

                if key in record:

                    case_id = str(
                        record[key]
                    )

                    break

            if case_id is None:
                continue

            edges = []

            for key in [
                "edges",
                "edge_list",
                "topology_edges",
                "relationships",
                "service_relationships",
            ]:

                if key in record:

                    edges = normalize_edges(
                        record[key]
                    )

                    break

            normalized[case_id] = {
                "edges": edges
            }

        return normalized

    return {}


