for name, parameter in model.named_parameters():

    grad = parameter.grad

    if grad is None:

        missing += 1

        print(
            name,
            ": NO GRADIENT"
        )

        continue

    grad_finite = bool(
        torch.isfinite(grad).all()
    )

    mean_abs = float(
        grad.abs().mean().item()
    )

    max_abs = float(
        grad.abs().max().item()
    )

    if grad_finite:
        finite += 1

    if max_abs > 0:
        nonzero += 1

    print(
        name,
        ":",
        "mean_abs=", mean_abs,
        "max_abs=", max_abs,
        "finite=", grad_finite
    )

print("\nGradient summary:")
print("Finite gradient tensors:", finite)
print("Non-zero gradient tensors:", nonzero)
print("Missing gradient tensors:", missing)

assert nonzero > 0
assert finite > 0

print("Gradient flow: PASS")


