print("\n" + "=" * 100)
print("8. DETAILED LOCALIZATION ANALYSIS")
print("=" * 100)

with torch.no_grad():

    for batch in loader:

        logits = model(batch)

        assert logits.shape[0] == batch.x.shape[0]
        assert logits.shape[1] == 1
        assert torch.isfinite(logits).all()

        node_start = 0

        for graph_idx in range(
            batch.num_graphs
        ):

            node_count = int(
                (
                    batch.batch
                    == graph_idx
                ).sum().item()
            )

            node_end = (
                node_start
                + node_count
            )

            scores = logits[
                node_start:node_end,
                0
            ]

            case_id = batch.case_id[
                graph_idx
            ]

            system = batch.system[
                graph_idx
            ]

            assert case_id in target_cases

            target = int(
                target_cases[
                    case_id
                ]["target_node_index"]
            )

            assert 0 <= target < node_count

            ranking = torch.argsort(
                scores,
                descending=True
            )

            predicted = int(
                ranking[0].item()
            )

            top3 = ranking[
                :min(3, node_count)
            ].tolist()

            top5 = ranking[
                :min(5, node_count)
            ].tolist()

            target_rank_tensor = (
                ranking == target
            ).nonzero(
                as_tuple=False
            )

            assert (
                target_rank_tensor.numel()
                > 0
            )

            target_rank = int(
                target_rank_tensor[0].item()
            ) + 1

            top1 = predicted == target
            top3_hit = target in top3
            top5_hit = target in top5

            if top1:
                top1_correct += 1

            if top3_hit:
                top3_correct += 1

            if top5_hit:
                top5_correct += 1

            total_graphs += 1

            target_score = float(
                scores[target].item()
            )

            predicted_score = float(
                scores[predicted].item()
            )

            score_std = float(
                scores.std().item()
            )

            score_mean = float(
                scores.mean().item()
            )

            score_min = float(
                scores.min().item()
            )

            score_max = float(
                scores.max().item()
            )

            row = {

                "case_id": case_id,

                "system": system,

                "target_node": target,

                "predicted_node": predicted,

                "target_rank": target_rank,

                "target_score": target_score,

                "predicted_score": predicted_score,

                "score_mean": score_mean,

                "score_std": score_std,

                "score_min": score_min,

                "score_max": score_max,

                "top1": bool(top1),

                "top3": bool(top3_hit),

                "top5": bool(top5_hit),

                "node_count": node_count,

                "top3_nodes": top3,

                "top5_nodes": top5
            }

            system_stats[
                system
            ].append(row)

            all_predictions.append(row)

            node_start = node_end


