# =============================================================================

print("\n" + "=" * 100)
print("4. FEATURE STATISTICS")
print("=" * 100)

STATISTICS = [
    "mean",
    "std",
    "min",
    "max",
]

print(
    "Statistics:",
    STATISTICS
)

# =============================================================================
# 6. BUILD CASE FEATURE VECTORS
# =============================================================================

print("\n" + "=" * 100)
print("5. BUILDING CASE FEATURE VECTORS")
print("=" * 100)

case_vectors = {}
case_feature_names = {}

global_feature_set = set()

for idx, record in enumerate(
    valid_records,
    start=1
):

    case = record["case"]

    path = os.path.join(
        ROOT,
        case,
        "metrics.parquet"
    )

    df = pd.read_parquet(path)

    # Only recognized metric columns.
    metric_columns = []

    for column in df.columns:

        family = classify_metric_column(
            column
        )

        if family is not None:

            metric_columns.append(
                str(column)
            )

    # Deterministic column ordering.
    metric_columns = sorted(
        metric_columns
    )

    vector = {}
    names = []

    for column in metric_columns:

        series = pd.to_numeric(
            df[column],
            errors="coerce"
        )

        # Do not silently fabricate values.
        # Statistics use available numeric observations.
        for stat in STATISTICS:

            feature_name = (
                f"{column}__{stat}"
            )

            if stat == "mean":
                value = series.mean()

            elif stat == "std":
                value = series.std(
                    ddof=1
                )

            elif stat == "min":
                value = series.min()

            elif stat == "max":
                value = series.max()

            else:
                raise ValueError(
                    f"Unknown statistic: {stat}"
                )

            vector[
                feature_name
            ] = (
                float(value)
                if pd.notna(value)
                else np.nan
            )

            names.append(
                feature_name
            )

            global_feature_set.add(
                feature_name
            )

    case_vectors[case] = vector
    case_feature_names[case] = names

    if idx % 25 == 0 or idx == len(valid_records):
        print(
            f"Constructed {idx}/{len(valid_records)}"
        )

