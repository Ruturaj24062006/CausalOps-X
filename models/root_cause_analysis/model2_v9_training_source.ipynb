        # node__family__stat

        parts = feature.rsplit(
            "__",
            1
        )

        if len(parts) != 2:
            continue

        node_family = parts[0]

        if node_family not in source_status[
            system
        ]:
            continue

        state = source_status[
            system
        ][
            node_family
        ][
            "status"
        ]

        if state == "ABSENT":

            absent_count += 1

            if len(
                examples_absent
