class Model2V9Corrected(torch.nn.Module):

    def __init__(
        self,
        node_input_dim=32,
        edge_input_dim=5,
        hidden_dim=128,
        num_layers=3,
        dropout=0.2
    ):

        super().__init__()

        assert node_input_dim == 32
        assert edge_input_dim == 5
        assert hidden_dim == 128
        assert num_layers == 3

        self.convs = torch.nn.ModuleList()

        # GCN layer 1
        self.convs.append(
            GCNConv(
                node_input_dim,
                hidden_dim
            )
        )

        # GCN layer 2
        self.convs.append(
            GCNConv(
                hidden_dim,
                hidden_dim
            )
        )

        # GCN layer 3
        self.convs.append(
            GCNConv(
                hidden_dim,
                hidden_dim
            )
        )

        self.dropout = torch.nn.Dropout(
            dropout
        )

        # Per-node score
        self.score_head = torch.nn.Linear(
            hidden_dim,
            1
        )

    def forward(
        self,
        data
    ):

        x = data.x
        edge_index = data.edge_index

        # Layer 1
        x = self.convs[0](
            x,
            edge_index
        )

        x = torch.relu(x)

        # Layer 2
        x = self.convs[1](
            x,
            edge_index
        )

        x = torch.relu(x)

        # Layer 3
        #
        # IMPORTANT:
        # NO ReLU HERE.
        #
        # Step 29 showed that applying ReLU to this
        # representation causes complete collapse for
        # Sock Shop and Train Ticket.

        x = self.convs[2](
            x,
            edge_index
        )

        # Per-node score
        logits = self.score_head(x)

        return logits


