# ================================================================================================

print("\n" + "=" * 100)
print("5. SYSTEM-WISE GRAPH AUDIT")
print("=" * 100)

actual_graph_counts = {
    system: 0
    for system in EXPECTED_NODES
}

actual_edge_counts = {
    system: 0
    for system in EXPECTED_NODES
}

system_failures = []

all_graphs_finite = True
all_indices_valid = True
all_edge_alignment_valid = True

for graph_index, graph in enumerate(
    graphs
):

    system = str(
        graph.system
    )

    if system not in EXPECTED_NODES:

        system_failures.append(
            (
                graph_index,
                system
            )
        )

        continue

    expected_nodes = (
        EXPECTED_NODES[system]
    )

    # ------------------------------------------------------------------
    # NODE FEATURE MATRIX
    # ------------------------------------------------------------------

    assert graph.x.ndim == 2

    if tuple(
        graph.x.shape
    ) != (
        expected_nodes,
        EXPECTED_NODE_FEATURES
    ):

        system_failures.append(
            (
                graph.case_id,
                "node_shape",
                tuple(graph.x.shape)
            )
        )

    # ------------------------------------------------------------------
    # EDGE INDEX
    # ------------------------------------------------------------------

    assert graph.edge_index.ndim == 2

    if graph.edge_index.shape[0] != 2:

        system_failures.append(
            (
                graph.case_id,
                "edge_index_shape",
                tuple(
                    graph.edge_index.shape
                )
            )
        )

    edge_count = int(
        graph.edge_index.shape[1]
    )

    # ------------------------------------------------------------------
    # EDGE ATTR
    # ------------------------------------------------------------------

    assert graph.edge_attr.ndim == 2

    if tuple(
        graph.edge_attr.shape
    ) != (
        edge_count,
        EXPECTED_EDGE_FEATURES
    ):

        all_edge_alignment_valid = False

        system_failures.append(
            (
                graph.case_id,
                "edge_attr_shape",
                tuple(
                    graph.edge_attr.shape
                )
            )
        )

    # ------------------------------------------------------------------
    # FINITE NODE FEATURES
    # ------------------------------------------------------------------

    if not torch.isfinite(
        graph.x
    ).all():

        all_graphs_finite = False

        system_failures.append(
            (
                graph.case_id,
                "non_finite_x"
            )
        )

    # ------------------------------------------------------------------
    # FINITE EDGE FEATURES
    # ------------------------------------------------------------------

    if not torch.isfinite(
        graph.edge_attr
    ).all():

        all_graphs_finite = False

        system_failures.append(
            (
                graph.case_id,
                "non_finite_edge_attr"
            )
        )

    # ------------------------------------------------------------------
    # NODE INDEX RANGE
    # ------------------------------------------------------------------

    if graph.edge_index.numel() > 0:

        minimum_index = int(
            graph.edge_index.min()
        )

        maximum_index = int(
            graph.edge_index.max()
        )

        if minimum_index < 0:

            all_indices_valid = False

            system_failures.append(
                (
                    graph.case_id,
                    "negative_node_index"
                )
            )

        if maximum_index >= expected_nodes:

            all_indices_valid = False

            system_failures.append(
                (
                    graph.case_id,
                    "node_index_out_of_range"
                )
            )

    # ------------------------------------------------------------------
    # COUNTS
    # ------------------------------------------------------------------

    actual_graph_counts[
        system
    ] += 1

    actual_edge_counts[
        system
    ] += edge_count


