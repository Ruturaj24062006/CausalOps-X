os.makedirs(OUT, exist_ok=True)

print("=" * 90)
print("CAUSALOPS X — MODEL 2 V9 STEP 4")
print("EXPORTING V9 TRAINING-SIDE RUNTIME SOURCE")
print("=" * 90)

# ------------------------------------------------------------
# 1. Inspect all Python / notebook files in working
# ------------------------------------------------------------

files = []

for root, dirs, filenames in os.walk("/kaggle/working"):
    dirs[:] = [
        d for d in dirs
        if d not in {
            ".cache",
            "__pycache__",
            ".git"
        }
    ]

    for filename in filenames:

        path = os.path.join(root, filename)

        if filename.endswith((".py", ".ipynb")):
            files.append(path)

print("\nPython/notebook files found:", len(files))

# ------------------------------------------------------------
# 2. Search for actual construction logic
# ------------------------------------------------------------

keywords = [
    "node_features",
    "node_feature_names",
    "edge_features",
    "edge_feature_names",
    "edge_attr",
    "edge_index",
    "service_to_node",
    "node_to_service",
    "node_mapping",
    "metrics.parquet",
    "traces.parquet",
    "logs.parquet",
    "inject_time.txt",
    "StandardScaler",
    "GCNConv",
    "torch_geometric",
    "target_node_index",
    "root_node_index",
    "model2_v9",
]

matches = []

for path in files:

    try:

        with open(
            path,
            "r",
            encoding="utf-8",
            errors="ignore"
        ) as f:
            text = f.read()

        found = []

        for keyword in keywords:

            if keyword.lower() in text.lower():
                found.append(keyword)

        if found:

            matches.append({
                "file": path,
                "keywords": found,
                "size": os.path.getsize(path)
            })

    except Exception:
        pass

print("\nCandidate V9 source files:")

for item in matches:

    print("\nFILE:", item["file"])
    print("SIZE:", item["size"])
    print("KEYWORDS:", ", ".join(item["keywords"]))

# ------------------------------------------------------------
# 3. Copy candidate source files
# ------------------------------------------------------------

copied = []

for i, item in enumerate(matches):

    source = item["file"]

    # Only copy reasonably sized source files
    if os.path.getsize(source) > 30 * 1024 * 1024:
        continue

    destination = os.path.join(
        OUT,
        f"source_{i:03d}_" + os.path.basename(source)
    )

    try:

        with open(
            source,
            "rb"
        ) as src:

            data = src.read()

        with open(
            destination,
            "wb"
        ) as dst:

            dst.write(data)

        sha = hashlib.sha256(data).hexdigest()

        copied.append({
            "source": source,
            "exported": destination,
            "size": len(data),
            "sha256": sha
        })

    except Exception as e:

        print(
            "COPY FAILED:",
            source,
            str(e)
        )

# ------------------------------------------------------------
# 4. Save inventory
# ------------------------------------------------------------

inventory = {
    "purpose":
        "V9 training-side source export for runtime reconstruction",

    "candidate_files":
        matches,

