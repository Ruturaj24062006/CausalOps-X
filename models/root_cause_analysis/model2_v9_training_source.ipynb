# ================================================================================================
# 5. MODEL ARCHITECTURE
# ================================================================================================

print("\n" + "=" * 100)
print("5. DEFINING PER-NODE MODEL")
print("=" * 100)


class Model2V9(nn.Module):

    def __init__(
        self,
        node_input_dim=32,
        edge_input_dim=5,
        hidden_dim=128,
        num_gnn_layers=3,
        dropout=0.2,
    ):

        super().__init__()

        self.node_input_dim = node_input_dim
        self.edge_input_dim = edge_input_dim
        self.hidden_dim = hidden_dim
        self.num_gnn_layers = num_gnn_layers
        self.dropout = dropout

        # IMPORTANT:
        # GCNConv does not consume edge_attr.
        # Edge features remain validated and preserved
        # in the graph dataset but are not passed into GCNConv.

        self.convs = nn.ModuleList()

        self.convs.append(
            GCNConv(
                node_input_dim,
                hidden_dim
            )
        )

        for _ in range(
            num_gnn_layers - 1
        ):

            self.convs.append(
                GCNConv(
                    hidden_dim,
                    hidden_dim
                )
            )

        self.dropout_layer = nn.Dropout(
            dropout
        )

        # Per-node scoring head.
        # NO global pooling.
        self.node_score = nn.Linear(
            hidden_dim,
            1
        )

    def forward(
        self,
        data
    ):

        x = data.x
        edge_index = data.edge_index

        for conv in self.convs:

            x = conv(
                x,
                edge_index
            )

            x = torch.relu(x)

            x = self.dropout_layer(
                x
            )

        # One score for every node.
        scores = self.node_score(
            x
        )

        return scores


model = Model2V9(
    node_input_dim=32,
    edge_input_dim=5,
    hidden_dim=128,
    num_gnn_layers=3,
    dropout=0.2,
)

