def extract_nodes(entry, system_name):
    """
    Extract the already-frozen node ordering.
    """

    if isinstance(entry, list):

        # Direct list of node names.
        if all(
            isinstance(x, str)
            for x in entry
        ):
            return list(entry)

        # List of node records.
        for item in entry:

            if isinstance(item, dict):

                for key in [
                    "node_order",
                    "nodes",
                    "service_names"
                ]:

                    if key in item:

                        value = item[key]

                        if isinstance(
                            value,
                            list
                        ):

                            return list(value)

    if isinstance(entry, dict):

        for key in [
            "node_order",
            "nodes",
            "service_names",
            "services"
        ]:

            if key in entry:

                value = entry[key]

                if isinstance(
                    value,
                    list
                ):

                    return list(value)

    raise AssertionError(
        f"Could not extract frozen node order for {system_name}"
    )


