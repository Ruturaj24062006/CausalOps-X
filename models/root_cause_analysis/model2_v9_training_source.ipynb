def build_targets(batch):

    targets = []

    for case_id in batch.case_id:

        target = int(
            target_cases[
                case_id
            ]["target_node_index"]
        )

        graph_index = len(
            targets
        )

        node_count = int(
            (
                batch.batch
                == graph_index
            ).sum().item()
        )

        assert (
            0 <= target < node_count
        )

        targets.append(
            target
        )

    return torch.tensor(
        targets,
        dtype=torch.long,
        device=batch.x.device
    )


