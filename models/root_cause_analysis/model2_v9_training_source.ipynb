# =============================================================================
# CAUSALOPS X — MODEL 2 V9
# STEP 2 — CASE TARGET + INJECTION-TIME AUDIT
# =============================================================================

import os
import re
import json
import pandas as pd
from collections import Counter, defaultdict

print("=" * 100)
print("CAUSALOPS X — MODEL 2 V9")
print("STEP 2 — CASE TARGET + INJECTION-TIME AUDIT")
print("=" * 100)

ROOT = "/kaggle/working/rcaeval_re2"

assert os.path.isdir(ROOT), f"Dataset not found: {ROOT}"

print("""
================================================================================
SAFETY
================================================================================

INSPECTION ONLY.

NO TRAINING.
NO FEATURE ENGINEERING.
NO FEATURE SELECTION.
NO GRAPH CONSTRUCTION.
NO MODEL MODIFICATION.

best_model_v8.pth WILL NOT BE TOUCHED.
""")

# =============================================================================
# 1. CASE INVENTORY
# =============================================================================

cases = sorted([
    x for x in os.listdir(ROOT)
    if os.path.isdir(os.path.join(ROOT, x))
    and x.startswith("re2")
])

print("=" * 100)
print("1. CASE INVENTORY")
print("=" * 100)

print("Total cases:", len(cases))

assert len(cases) == 270

# =============================================================================
# 2. CASE NAME PARSER
# =============================================================================

print("\n" + "=" * 100)
print("2. CASE NAME PARSING")
print("=" * 100)

faults = [
    "cpu",
    "delay",
    "disk",
    "loss",
    "mem",
    "socket",
]

def parse_case(case):

    if case.startswith("re2ob_"):
        system = "Online Boutique"
        remainder = case[len("re2ob_"):]

    elif case.startswith("re2ss_"):
        system = "Sock Shop"
        remainder = case[len("re2ss_"):]

    elif case.startswith("re2tt_"):
        system = "Train Ticket"
        remainder = case[len("re2tt_"):]

    else:
        return None

    # Fault and replicate are always at the end:
    # _cpu_1, _delay_2, etc.
    match = re.search(
        r"_(cpu|delay|disk|loss|mem|socket)_([123])$",
        remainder
    )

    if not match:
        return None

    fault_type = match.group(1)
    replicate = int(match.group(2))

    service = remainder[
        :match.start()
    ]

    if not service:
        return None

    return {
        "system": system,
        "root_cause_service": service,
        "fault_type": fault_type,
        "replicate": replicate,
    }


parsed_cases = {}
parse_failures = []

for case in cases:

    parsed = parse_case(case)

    if parsed is None:
        parse_failures.append(case)
    else:
        parsed_cases[case] = parsed

print(
    "Successfully parsed:",
    len(parsed_cases)
)

print(
    "Parse failures:",
    len(parse_failures)
)

if parse_failures:
    for case in parse_failures:
