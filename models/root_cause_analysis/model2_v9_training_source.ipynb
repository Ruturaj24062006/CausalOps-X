# ================================================================================================
# 8. REPRESENTATION STATISTICS FUNCTION
# ================================================================================================

def representation_stats(
    tensor,
    graph_list,
    ptr
):

    values = tensor.detach().cpu()

    assert values.ndim == 2

    global_mean = float(
        values.mean().item()
    )

    global_std = float(
        values.std(unbiased=False).item()
    )

    global_min = float(
        values.min().item()
    )

    global_max = float(
        values.max().item()
    )

    dimension_std = values.std(
        dim=0,
        unbiased=False
    )

    mean_dimension_std = float(
        dimension_std.mean().item()
    )

    zero_variance_dimensions = int(
        (
            dimension_std
            <= 1e-12
        ).sum().item()
    )

    graph_ranges = []
    collapsed_graphs = 0

    for i in range(
        len(graph_list)
    ):

        start = int(
            ptr[i]
        )

        end = int(
            ptr[i + 1]
        )

        graph_values = values[
            start:end
        ]

        if graph_values.shape[0] == 0:
            continue

        graph_min = graph_values.min(
            dim=0
        ).values

        graph_max = graph_values.max(
            dim=0
        ).values

        graph_range = (
            graph_max - graph_min
        )

        mean_range = float(
            graph_range.mean().item()
        )

        graph_ranges.append(
            mean_range
        )

        if torch.all(
            graph_range <= 1e-12
        ):

            collapsed_graphs += 1

    if graph_ranges:

        mean_within_graph_range = float(
            np.mean(graph_ranges)
        )

    else:

        mean_within_graph_range = 0.0

    return {
        "shape": list(values.shape),
        "mean": global_mean,
        "std": global_std,
        "min": global_min,
        "max": global_max,
        "mean_dimension_std": mean_dimension_std,
        "zero_variance_dimensions":
            zero_variance_dimensions,
        "mean_within_graph_range":
            mean_within_graph_range,
        "collapsed_graphs":
            collapsed_graphs
    }


