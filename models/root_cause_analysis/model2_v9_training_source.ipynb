    )

    # node -> family -> statistic
    values = {}

    for node in nodes:

        values[node] = {}

        for family in metric_families:

            values[node][family] = {
                stat: np.nan
                for stat in statistics
            }

    # --------------------------------------------------------------------------------
    # PROCESS ACTUAL METRIC COLUMNS
    # --------------------------------------------------------------------------------

    for column in df.columns:

        node, family = classify_metric_column(
            column,
            nodes
        )

        if node is None:
            continue

        if family is None:
            continue

        numeric = pd.to_numeric(
            df[column],
            errors="coerce"
        )

        array = numeric.to_numpy(
            dtype=float
        )

        finite = array[
            np.isfinite(array)
        ]

        if len(finite) == 0:
            continue

        values[node][family][
            "mean"
        ] = float(
            np.mean(finite)
        )

        values[node][family][
            "std"
        ] = float(
            np.std(
                finite,
                ddof=0
            )
        )

        values[node][family][
            "min"
        ] = float(
            np.min(finite)
        )

        values[node][family][
            "max"
        ] = float(
            np.max(finite)
        )

    # --------------------------------------------------------------------------------
    # FREEZE VECTOR ORDER
    # --------------------------------------------------------------------------------

    vector = []

    for node in nodes:

        for family in metric_families:

            for stat in statistics:

                vector.append(
                    values[node][family][stat]
                )

    vector = np.asarray(
        vector,
        dtype=np.float64
    )

    expected_dim = (
        len(nodes)
        *
        NODE_FEATURE_DIM
    )

    assert vector.shape == (
        expected_dim,
    )

    system_matrices[
        system
    ][case] = vector

    case_metadata[
        case
    ] = {
        "system":
            system,
        "node_count":
            len(nodes),
        "feature_dimension":
            int(expected_dim)
    }

    processed += 1

    if (
        processed % 25 == 0
        or processed == len(all_cases)
    ):

        print(
            f"Processed: "
            f"{processed}/{len(all_cases)}"
        )

# ----------------------------------------------------------------------------------------------------
# RAW MISSINGNESS
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("8. RAW NODE FEATURE MISSINGNESS")
print("=" * 100)

raw_missingness = {}

for system in expected_systems:

    ordered_cases = sorted(
        system_matrices[system]
    )

    matrix = np.vstack(
        [
            system_matrices[
                system
            ][case]
            for case in ordered_cases
        ]
    )

    missing = ~np.isfinite(
        matrix
    )

    raw_missingness[
        system
    ] = {
        "total_values":
            int(matrix.size),

        "missing_values":
            int(missing.sum()),

        "missing_percentage":
            float(
                100.0
                *
                missing.mean()
            )
    }

    print(
