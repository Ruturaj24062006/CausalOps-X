def scale_graph(g):

    new_g = copy.deepcopy(g)

    x = (
        new_g.x
        .detach()
        .cpu()
        .numpy()
        .astype(np.float64)
    )

    scaled = scaler.transform(x)

    assert scaled.shape == x.shape
    assert scaled.shape[1] == 32
    assert np.isfinite(scaled).all()

    new_g.x = torch.tensor(
        scaled,
        dtype=torch.float32
    )

    return new_g


