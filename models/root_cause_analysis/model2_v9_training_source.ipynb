print("=" * 100)

#
# We distinguish:
#
# A. Features constant at a non-zero value
# B. Features constant at zero
#
# This helps determine whether zero variance is caused
# by genuinely constant measurements or by missing-data
# representation.
#
# NO FEATURES ARE REMOVED.
#

constant_source_summary = {}

for system in systems:

    matrix = matrices[
        system
    ]

    names = feature_names[
        system
    ]

    variances = np.var(
        matrix,
        axis=0,
        ddof=0
    )

    zero_indices = np.where(
        variances <= 1e-12
    )[0]

    zero_constant = []
    nonzero_constant = []

    for idx in zero_indices:

        values = matrix[:, idx]

        if np.all(
            np.abs(values)
            <= 1e-12
        ):

            zero_constant.append(
                names[idx]
            )

        else:

            nonzero_constant.append(
                names[idx]
            )

    constant_source_summary[
        system
    ] = {

        "constant_zero":
            zero_constant,

        "constant_nonzero":
            nonzero_constant,

        "constant_zero_count":
            len(zero_constant),

        "constant_nonzero_count":
            len(nonzero_constant)
    }

    print(
        f"\n{system}"
    )

    print(
        "  Constant zero:",
        len(zero_constant)
    )

    print(
        "  Constant non-zero:",
        len(nonzero_constant)
    )

