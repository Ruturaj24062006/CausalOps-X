    def find_case_edge_data(obj, wanted_case):

        if isinstance(obj, dict):

            if wanted_case in obj:

                value = obj[wanted_case]

                if isinstance(value, dict):
                    return value

            for value in obj.values():

                found = find_case_edge_data(
                    value,
                    wanted_case
                )

                if found is not None:
                    return found

        elif isinstance(obj, list):

            for value in obj:

                if isinstance(value, dict):

                    for key in [
                        "case_id",
                        "caseId",
                        "case",
                        "id",
                    ]:

                        if (
                            key in value
                            and
                            str(value[key])
                            == wanted_case
                        ):

                            return value

                    found = find_case_edge_data(
                        value,
                        wanted_case
                    )

                    if found is not None:
                        return found

        return None

    edge_case_data = find_case_edge_data(
