# --------------------------------------------------------------------------------
# Recursive structural inspection
# --------------------------------------------------------------------------------

def inspect_structure(obj, path="ROOT", depth=0, max_depth=5):

    indent = "  " * depth

    if depth > max_depth:
        print(
            indent +
            f"{path}: <maximum inspection depth reached>"
        )
        return

    if isinstance(obj, dict):

        print(
            indent +
            f"{path}: dict ({len(obj)} keys)"
        )

        for key, value in obj.items():

            key_path = (
                f"{path}.{key}"
            )

            if isinstance(value, (dict, list)):

                inspect_structure(
                    value,
                    key_path,
                    depth + 1,
                    max_depth
                )

            else:

                print(
                    "  " * (depth + 1)
                    +
                    f"{key_path}: "
                    f"{type(value).__name__} = "
                    f"{repr(value)[:160]}"
                )

    elif isinstance(obj, list):

        print(
            indent +
            f"{path}: list ({len(obj)} items)"
        )

        for i, value in enumerate(
            obj[:10]
        ):

            item_path = (
                f"{path}[{i}]"
            )

            if isinstance(value, (dict, list)):

                inspect_structure(
                    value,
                    item_path,
                    depth + 1,
                    max_depth
                )

            else:

                print(
                    "  " * (depth + 1)
                    +
                    f"{item_path}: "
                    f"{type(value).__name__} = "
                    f"{repr(value)[:160]}"
                )

        if len(obj) > 10:

            print(
                indent +
                "  ... "
                +
                f"{len(obj)-10} more items"
            )


print("\n" + "=" * 100)
print("2. CONTRACT STRUCTURE")
print("=" * 100)

