def find_system_node_definitions(obj):
    """
    Locate the STEP 7 system node definitions without
    assuming whether they are stored as dict or list.
    """

    expected = {
        "Online Boutique",
        "Sock Shop",
        "Train Ticket"
    }

    # Case 1: direct dictionary keyed by system name.
    if isinstance(obj, dict):

        if expected.issubset(
            set(obj.keys())
        ):

            return {
                key: obj[key]
                for key in expected
            }

        # Search common wrapper keys.
        for key in [
            "systems",
            "system_node_contract",
            "system_contract",
            "node_contract",
            "system_nodes"
        ]:

            if key in obj:

                result = find_system_node_definitions(
                    obj[key]
                )

                if result is not None:
                    return result

        # Recursive search through dictionary values.
        for value in obj.values():

            if isinstance(
                value,
                (dict, list)
            ):

                result = find_system_node_definitions(
                    value
                )

                if result is not None:
                    return result

    # Case 2: list containing system records.
    elif isinstance(obj, list):

        found = {}

        for item in obj:

            if not isinstance(
                item,
                dict
            ):
                continue

            # Possible system-name fields.
            system_name = None

            for key in [
                "system",
                "system_name",
                "name",
                "application"
            ]:

                if key in item:

                    candidate = str(
                        item[key]
                    )

                    if candidate in expected:

                        system_name = candidate
                        break

            if system_name is not None:

                found[
                    system_name
                ] = item

        if expected.issubset(
            set(found.keys())
        ):

            return found

        # Recursive search inside list items.
        for item in obj:

            if isinstance(
                item,
                (dict, list)
            ):

                result = find_system_node_definitions(
                    item
                )

                if result is not None:
                    return result

    return None


