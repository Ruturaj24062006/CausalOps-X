class Model2V9(torch.nn.Module):

    def __init__(
        self,
        node_input_dim=32,
        edge_input_dim=5,
        hidden_dim=128,
        num_layers=3,
        dropout=0.2
    ):

        super().__init__()

        self.convs = torch.nn.ModuleList()

        self.convs.append(
            GCNConv(
                node_input_dim,
                hidden_dim
            )
        )

        for _ in range(num_layers - 1):

            self.convs.append(
                GCNConv(
                    hidden_dim,
                    hidden_dim
                )
            )

        self.dropout = torch.nn.Dropout(
            dropout
        )

        self.score_head = torch.nn.Linear(
            hidden_dim,
            1
        )

    def forward_with_intermediates(
        self,
        data
    ):

        x = data.x
        edge_index = data.edge_index

        outputs = {}

        # Stage 0
        outputs["raw"] = x.detach().clone()

        # Layer 1
        x = self.convs[0](
            x,
            edge_index
        )

        outputs["layer1_pre_relu"] = (
            x.detach().clone()
        )

        x = torch.relu(x)

        outputs["layer1_post_relu"] = (
            x.detach().clone()
        )

        # Layer 2
        x = self.convs[1](
            x,
            edge_index
        )

        outputs["layer2_pre_relu"] = (
            x.detach().clone()
        )

        x = torch.relu(x)

        outputs["layer2_post_relu"] = (
            x.detach().clone()
        )

        # Layer 3
        x = self.convs[2](
            x,
            edge_index
        )

        outputs["layer3_pre_relu"] = (
            x.detach().clone()
        )

        x = torch.relu(x)

        outputs["layer3_post_relu"] = (
            x.detach().clone()
        )

        # Score head
        logits = self.score_head(x)

        outputs["score"] = (
            logits.detach().clone()
        )

        return outputs


