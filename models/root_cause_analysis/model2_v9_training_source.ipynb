# ================================================================================================
# 14. PER-GRAPH LOSS
# ================================================================================================

criterion = nn.CrossEntropyLoss()


def compute_batch_loss(
    logits,
    batch,
    batch_targets
):

    """
    logits:
        [total_nodes, 1]

    For each graph:
        [nodes, 1]
        ->
        [1, nodes]

    target:
        local node index

    CrossEntropyLoss therefore treats
    the nodes of each graph as classes.
    """

    assert logits.ndim == 2
    assert logits.shape[1] == 1

    losses = []

    node_start = 0

    for graph_index in range(
        batch.num_graphs
    ):

        node_count = int(
            (batch.batch == graph_index)
            .sum()
            .item()
        )

        node_end = (
            node_start + node_count
        )

        graph_logits = logits[
            node_start:node_end
        ].reshape(
            1,
            node_count
        )

        target = batch_targets[
            graph_index
        ].reshape(1)

        assert (
            0 <= int(target.item())
            < node_count
        )

        graph_loss = criterion(
            graph_logits,
            target
        )

        losses.append(
            graph_loss
        )

        node_start = node_end

    return torch.stack(
        losses
    ).mean()


# ================================================================================================
# 15. TARGET BUILDER
# ================================================================================================

def build_batch_targets(
    batch
):

    targets = []

    for case_id in batch.case_id:

        target = int(
            target_cases[
                case_id
            ]["target_node_index"]
        )

        node_count = int(
            (batch.batch == len(targets))
            .sum()
            .item()
        )

        assert (
            0 <= target < node_count
        )

        targets.append(
            target
        )

    return torch.tensor(
        targets,
        dtype=torch.long,
        device=batch.x.device
    )


