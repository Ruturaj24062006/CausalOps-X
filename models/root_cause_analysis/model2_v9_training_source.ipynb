        matrix,
        axis=0,
        ddof=0
    )

    zero_mask = (
        variances <= 1e-12
    )

    near_zero_mask = (
        variances > 1e-12
    ) & (
        variances <= 1e-8
    )

    constant_features = [
        names[i]
        for i in range(
            len(names)
        )
        if zero_mask[i]
    ]

