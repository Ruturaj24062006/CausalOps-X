print("=" * 100)


def production_predict(graph):

    original_x = graph.x.clone()

    original_edge_index = (
        graph.edge_index.clone()
    )

    original_edge_attr = (
        graph.edge_attr.clone()
    )

    runtime_graph = graph.clone()

    x_np = (
        runtime_graph.x
        .detach()
        .cpu()
        .numpy()
    )

    scaled_x = scaler.transform(
        x_np
    )

    assert scaled_x.shape == x_np.shape
    assert np.isfinite(
        scaled_x
    ).all()

    runtime_graph.x = torch.tensor(
        scaled_x,
        dtype=torch.float32
    )

    loader = DataLoader(
        [runtime_graph],
        batch_size=1,
        shuffle=False
    )

    batch = next(
        iter(loader)
    )

    assert (
        batch.x.device.type
        == "cpu"
    )

    batch = batch.to(device)

    with torch.no_grad():

        logits = model(batch)

    assert logits.ndim == 2

    assert logits.shape[1] == 1

    assert (
        logits.shape[0]
        == graph.x.shape[0]
    )

    assert torch.isfinite(
        logits
    ).all()

    scores = logits[:, 0]

    predicted_node = int(
        torch.argmax(scores).item()
    )

    assert torch.equal(
        graph.x,
        original_x
    )

    assert torch.equal(
        graph.edge_index,
        original_edge_index
    )

    assert torch.equal(
        graph.edge_attr,
        original_edge_attr
    )

    return {
        "predicted_node": predicted_node,
        "num_nodes": int(
            graph.x.shape[0]
        ),
        "scores": (
            scores
            .detach()
            .cpu()
            .numpy()
            .tolist()
        )
    }


