def find_case_container(obj):

    """
    Recursively find the dictionary that appears to contain
    case-level topology information.

    This function only reads the existing contract.
    It never creates topology.
    """

    if isinstance(obj, dict):

        keys_lower = {
            str(k).lower()
            for k in obj.keys()
        }

        case_indicators = [
            "cases",
            "graphs",
            "topology",
            "case_topology",
            "case_graphs",
        ]

        for key in case_indicators:

            if key in keys_lower:

                for original_key in obj.keys():

                    if str(original_key).lower() == key:

                        value = obj[original_key]

                        if isinstance(value, dict):

                            return value

                        if isinstance(value, list):

                            return value

        # Search nested dictionaries.
        for value in obj.values():

            found = find_case_container(value)

            if found is not None:
                return found

    return None


