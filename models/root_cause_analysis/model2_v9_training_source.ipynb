print("\n" + "=" * 100)
print("2. CASE / SYSTEM MAPPING")
print("=" * 100)

case_system = {}

for system in systems:

    nodes = node_contract[
        "system_nodes"
    ][system]

    assert len(nodes) > 0

# Infer system directly from case prefix.
def get_system(case):

    if case.startswith("re2ob_"):
        return "Online Boutique"

    if case.startswith("re2ss_"):
        return "Sock Shop"

    if case.startswith("re2tt_"):
        return "Train Ticket"

    return None

# ----------------------------------------------------------------------------------------------------
# 3. RECOVER CASE-LEVEL EDGES
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("3. RECOVERING CASE-LEVEL GRAPH TOPOLOGY")
print("=" * 100)

raw_case_edges = graph_audit.get(
    "case_edges",
    {}
)

final_case_graphs = {}

endpoint_failures = []
duplicate_edges = 0
valid_edges = 0

for case in sorted(raw_case_edges.keys()):

    system = get_system(case)

    if system is None:

        endpoint_failures.append({
            "case": case,
            "reason": "unknown system"
        })

        continue

    service_to_index = node_contract[
        "node_index"
    ][system]

    edges = raw_case_edges[
        case
    ]

    unique_pairs = set()
    final_edges = []

    for edge in edges:

        source = edge.get(
            "source_service"
        )

        target = edge.get(
            "target_service"
        )

        call_count = edge.get(
            "call_count",
            0
        )

        if not source or not target:

            endpoint_failures.append({
                "case": case,
                "reason": "empty endpoint",
                "edge": edge
            })

            continue

        if source not in service_to_index:

            endpoint_failures.append({
                "case": case,
                "reason": "source not in node contract",
                "service": source
            })

            continue

        if target not in service_to_index:

            endpoint_failures.append({
                "case": case,
                "reason": "target not in node contract",
                "service": target
            })

            continue

        pair = (
            source,
            target
        )

        if pair in unique_pairs:

            duplicate_edges += 1
            continue

        unique_pairs.add(pair)

        final_edges.append({
            "source_service": source,
            "target_service": target,
            "source_node": int(
                service_to_index[source]
            ),
            "target_node": int(
                service_to_index[target]
            ),
            "call_count": int(
                call_count
            )
        })

        valid_edges += 1

    final_edges = sorted(
        final_edges,
        key=lambda x: (
            x["source_node"],
            x["target_node"]
        )
    )

    final_case_graphs[case] = {
        "system": system,
        "trace_available": True,
        "edge_count": len(final_edges),
        "edges": final_edges
    }

