def find_split_lists(obj):

    if isinstance(obj, dict):

        lower_keys = {
            str(k).lower(): k
            for k in obj.keys()
        }

        train_key = None
        val_key = None
        test_key = None

        for low, original in lower_keys.items():

            if low in ("train", "train_cases"):
                train_key = original

            elif low in (
                "validation",
                "validation_cases",
                "val",
                "val_cases"
            ):
                val_key = original

            elif low in ("test", "test_cases"):
                test_key = original

        if (
            train_key is not None
            and val_key is not None
            and test_key is not None
        ):

            if (
                isinstance(obj[train_key], list)
                and isinstance(obj[val_key], list)
                and isinstance(obj[test_key], list)
            ):
                return (
                    obj[train_key],
                    obj[val_key],
                    obj[test_key]
                )

        for value in obj.values():

            result = find_split_lists(value)

            if result is not None:
                return result

    elif isinstance(obj, list):

        for value in obj:

            result = find_split_lists(value)

            if result is not None:
                return result

    return None


