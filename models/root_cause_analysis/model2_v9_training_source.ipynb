# ----------------------------------------------------------------------------------------------------
# 14. GRAPH-LOCAL CROSS ENTROPY
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("14. GRAPH-LOCAL CROSS ENTROPY")
print("=" * 100)

criterion = nn.CrossEntropyLoss()

graph_losses = []

offset = 0

for graph_index in range(batch.num_graphs):

    num_nodes = int(
        (batch.batch == graph_index).sum().item()
    )

    start = offset
    end = offset + num_nodes

    graph_logits = logits[
        start:end
    ].reshape(1, -1)

    graph_target = targets[
        graph_index
    ].reshape(1)

    assert (
        0 <= int(graph_target.item()) < num_nodes
    )

    graph_loss = criterion(
        graph_logits,
        graph_target
    )

    graph_losses.append(graph_loss)

    offset = end

loss = torch.stack(
    graph_losses
).mean()

assert torch.isfinite(loss)
assert loss.requires_grad

print("Loss:", float(loss.detach().item()))
