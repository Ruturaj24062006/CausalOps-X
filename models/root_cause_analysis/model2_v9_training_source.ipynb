    split_by_system,
    dict
)


def find_split_list(obj, names):

    if isinstance(obj, dict):

        for name in names:

            if (
                name in obj
                and isinstance(obj[name], list)
            ):
                return obj[name]

        for value in obj.values():

            result = find_split_list(
                value,
                names
            )

            if result is not None:
                return result

    elif isinstance(obj, list):

        for value in obj:

            result = find_split_list(
                value,
                names
            )

            if result is not None:
                return result

    return None


