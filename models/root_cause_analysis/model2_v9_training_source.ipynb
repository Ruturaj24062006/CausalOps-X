print("=" * 100)

records = []

for index, case in enumerate(cases, start=1):

    info = parsed_cases[case]

    case_path = os.path.join(
        ROOT,
        case
    )

    metrics_path = os.path.join(
        case_path,
        "metrics.parquet"
    )

    inject_path = os.path.join(
        case_path,
        "inject_time.txt"
    )

    metrics_exists = os.path.isfile(
        metrics_path
    )

    inject_exists = os.path.isfile(
        inject_path
    )

    # -------------------------------------------------------------------------
    # Defaults
    # -------------------------------------------------------------------------

    metric_rows = None
    metric_time_min = None
    metric_time_max = None
    metric_unique_times = None

    timestamps_monotonic = False
    timestamps_duplicate = None

    inject_raw = None
    inject_time = None
    inject_parse_success = False
    inject_time_in_range = False

    root_metric_columns = []
    root_metric_families = []

    invalid_reasons = []

    # -------------------------------------------------------------------------
    # Metrics
    # -------------------------------------------------------------------------

    if not metrics_exists:

        invalid_reasons.append(
            "missing_metrics"
        )

    else:

        try:

            df = pd.read_parquet(
                metrics_path
            )

            metric_rows = len(df)

            if len(df) == 0:

                invalid_reasons.append(
                    "empty_metrics"
                )

            if "time" not in df.columns:

                invalid_reasons.append(
                    "missing_time_column"
                )

            else:

                time = df["time"]

                if not pd.api.types.is_numeric_dtype(
                    time
                ):

                    invalid_reasons.append(
                        "non_numeric_time"
                    )

                else:

                    metric_time_min = int(
                        time.min()
                    )

                    metric_time_max = int(
                        time.max()
                    )

                    metric_unique_times = int(
                        time.nunique()
                    )

                    timestamps_monotonic = bool(
                        time.is_monotonic_increasing
                    )

                    timestamps_duplicate = bool(
                        time.duplicated().any()
                    )

                    if not timestamps_monotonic:

                        invalid_reasons.append(
                            "non_monotonic_timestamps"
                        )

                    if timestamps_duplicate:

                        invalid_reasons.append(
                            "duplicate_timestamps"
                        )

            # -----------------------------------------------------------------
            # Root service metrics
            # -----------------------------------------------------------------

            service = info[
                "root_cause_service"
            ]

            prefix = service + "_"

            root_metric_columns = [
                str(c)
                for c in df.columns
                if str(c).startswith(prefix)
            ]

            family_candidates = [
                "cpu",
                "mem",
                "diskio",
                "socket",
                "workload",
                "error",
                "latency-50",
                "latency-90",
            ]

            for family in family_candidates:

                if any(
                    c == f"{service}_{family}"
                    for c in root_metric_columns
                ):

                    root_metric_families.append(
                        family
                    )

        except Exception as e:

            invalid_reasons.append(
                "metrics_read_error:" + str(e)
            )

    # -------------------------------------------------------------------------
    # Injection time
    # -------------------------------------------------------------------------

    if not inject_exists:

        invalid_reasons.append(
            "missing_inject_time"
        )

    else:

        try:

            with open(
                inject_path,
                "r",
                encoding="utf-8",
                errors="replace"
            ) as f:

                inject_raw = f.read().strip()

            if not inject_raw:

                invalid_reasons.append(
                    "empty_inject_time"
                )

            else:

                # Try numeric Unix timestamp first.
                try:

                    inject_numeric = float(
                        inject_raw
                    )

                    inject_time = int(
                        inject_numeric
                    )

                    inject_parse_success = True

                except Exception:

                    # Then try pandas datetime.
                    parsed_datetime = pd.to_datetime(
                        inject_raw,
                        errors="coerce"
                    )

                    if pd.isna(parsed_datetime):

                        invalid_reasons.append(
                            "invalid_inject_time"
                        )

                    else:

                        # Convert datetime to Unix seconds.
                        inject_time = int(
                            parsed_datetime.timestamp()
                        )

                        inject_parse_success = True

        except Exception as e:

            invalid_reasons.append(
                "inject_time_read_error:" + str(e)
            )

    # -------------------------------------------------------------------------
    # Injection time range
    # -------------------------------------------------------------------------

    if (
        inject_parse_success
        and metric_time_min is not None
        and metric_time_max is not None
    ):

        inject_time_in_range = (
            metric_time_min
            <= inject_time
            <= metric_time_max
        )

        if not inject_time_in_range:

            invalid_reasons.append(
                "inject_time_outside_metric_range"
            )

    # -------------------------------------------------------------------------
    # Root service availability
    # -------------------------------------------------------------------------

    root_service_metric_count = len(
        root_metric_columns
    )

    if root_service_metric_count == 0:

        invalid_reasons.append(
            "root_service_no_metrics"
        )

    # -------------------------------------------------------------------------
    # Validity
    # -------------------------------------------------------------------------

    case_valid = (
        len(invalid_reasons) == 0
    )

    records.append({

        "case": case,

        "system": info[
            "system"
        ],

        "root_cause_service": info[
            "root_cause_service"
        ],

        "fault_type": info[
            "fault_type"
        ],

        "replicate": info[
            "replicate"
        ],

        "inject_time_raw": inject_raw,

        "inject_time": inject_time,

        "inject_time_parse_success":
            inject_parse_success,

        "metric_rows":
            metric_rows,

        "metric_time_min":
            metric_time_min,

        "metric_time_max":
            metric_time_max,

        "metric_unique_times":
            metric_unique_times,

        "timestamps_monotonic":
            timestamps_monotonic,

        "timestamps_duplicate":
            timestamps_duplicate,

        "inject_time_in_range":
            inject_time_in_range,

        "root_service_metric_count":
            root_service_metric_count,

        "root_service_metric_columns":
            root_metric_columns,

        "root_service_metric_families":
            root_metric_families,

        "metrics_exists":
            metrics_exists,

        "inject_time_exists":
            inject_exists,

        "case_valid":
            case_valid,

        "invalid_reason":
            ";".join(invalid_reasons)
            if invalid_reasons
            else "",

    })

    if index % 25 == 0 or index == len(cases):

        print(
            f"Audited {index}/{len(cases)}"
        )

