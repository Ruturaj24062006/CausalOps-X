]

def find_column(
    columns,
    candidates
):

    lookup = {
        str(c).lower(): str(c)
        for c in columns
    }

    for candidate in candidates:

        if candidate.lower() in lookup:

            return lookup[
                candidate.lower()
            ]

    return None

for index, case in enumerate(
    trace_cases,
    start=1
):

    path = os.path.join(
        ROOT,
        case,
        "traces.parquet"
    )

    try:

        df = pd.read_parquet(path)

        source_col = find_column(
            df.columns,
            SOURCE_CANDIDATES
        )

        target_col = find_column(
            df.columns,
            TARGET_CANDIDATES
        )

        if (
            source_col is None
            or target_col is None
        ):

            case_edge_counts[
                case
            ] = 0

            continue

        valid_edges = 0
        local_edges = Counter()

        for _, row in df.iterrows():

            source = row[source_col]
            target = row[target_col]

            if (
                pd.isna(source)
                or pd.isna(target)
            ):

                continue

            source = str(source).strip()
            target = str(target).strip()

            if (
                not source
                or not target
                or source == target
            ):

                continue

            edge = (
                source,
                target
            )

            local_edges[
                edge
            ] += 1

            valid_edges += 1

        case_edge_counts[
            case
        ] = len(local_edges)

        for edge, count in local_edges.items():

            relationship_counts[
                edge
            ] += count

    except Exception as exc:

        trace_read_failures.append(
            (
                case,
                str(exc)
            )
        )

    if (
        index % 25 == 0
        or index == len(trace_cases)
    ):

        print(
            f"Processed "
            f"{index}/{len(trace_cases)}"
        )

