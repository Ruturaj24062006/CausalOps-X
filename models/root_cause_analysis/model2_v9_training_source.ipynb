def get_hidden_representation(
    model,
    batch
):

    x = batch.x
    edge_index = batch.edge_index

    hidden = None

    for conv in model.convs:

        x = conv(
            x,
            edge_index
        )

        x = torch.relu(x)

        hidden = x

    return hidden


