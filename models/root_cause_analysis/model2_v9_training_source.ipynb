# ================================================================================================
# 13. TARGET FUNCTION
# ================================================================================================

def get_targets(batch):

    case_ids = batch.case_id

    if isinstance(case_ids, str):
        case_ids = [case_ids]

    targets = []

    for case_id in case_ids:

        case_id = str(case_id)

        assert case_id in target_cases

        target = int(
            target_cases[case_id][
                "target_node_index"
            ]
        )

        targets.append(target)

    targets = torch.tensor(
        targets,
        dtype=torch.long,
        device=batch.x.device
    )

    assert len(targets) == batch.num_graphs

    for i in range(batch.num_graphs):

        start = int(batch.ptr[i])
        end = int(batch.ptr[i + 1])

        node_count = end - start

        assert 0 <= int(targets[i]) < node_count

    return targets


# ================================================================================================
# 14. GRAPH-LOCAL CROSS ENTROPY
# ================================================================================================

criterion = nn.CrossEntropyLoss()


def graph_local_loss(
    logits,
    batch,
    targets
):

    assert logits.ndim == 2
    assert logits.shape[1] == 1

    losses = []

    for graph_idx in range(
        batch.num_graphs
    ):

        start = int(
            batch.ptr[graph_idx]
        )

        end = int(
            batch.ptr[graph_idx + 1]
        )

        scores = logits[
            start:end,
            0
        ]

        target = targets[
            graph_idx
        ].view(1)

        scores = scores.unsqueeze(0)

        loss = criterion(
            scores,
            target
        )

        losses.append(loss)

    return torch.stack(
        losses
    ).mean()


# ================================================================================================
# 15. METRICS
# ================================================================================================

@torch.no_grad()
def metrics(
    logits,
    batch,
    targets
):

    top1 = 0
    top3 = 0
    top5 = 0

    for graph_idx in range(
        batch.num_graphs
    ):

        start = int(
            batch.ptr[graph_idx]
        )

        end = int(
            batch.ptr[graph_idx + 1]
        )

        scores = logits[
            start:end,
            0
        ]

        target = int(
            targets[graph_idx]
        )

        ranking = torch.argsort(
            scores,
            descending=True
        )

        if target == int(
            ranking[0]
        ):
            top1 += 1

        if target in ranking[
            :min(3, len(ranking))
        ].tolist():
            top3 += 1

        if target in ranking[
            :min(5, len(ranking))
        ].tolist():
            top5 += 1

    n = batch.num_graphs

    return (
        top1 / n,
        top3 / n,
        top5 / n
    )


# ================================================================================================
# 16. TRAINING FUNCTION
# ================================================================================================

def train_one_epoch(
    model,
    loader,
    optimizer
):

    model.train()

    total_loss = 0.0
    total_graphs = 0

    total_top1 = 0.0
    total_top3 = 0.0
    total_top5 = 0.0

    for batch in loader:

        # CPU graph tensors remain untouched until
        # the complete batch is moved to device.
        batch = batch.to(device)

        optimizer.zero_grad(
            set_to_none=True
        )

        logits = model(batch)

        assert logits.shape == (
            batch.x.shape[0],
            1
        )

        assert torch.isfinite(
            logits
        ).all()

        targets = get_targets(
            batch
        )

        loss = graph_local_loss(
            logits,
            batch,
            targets
        )

        assert torch.isfinite(loss)

        loss.backward()

        torch.nn.utils.clip_grad_norm_(
            model.parameters(),
            max_norm=5.0
        )

        optimizer.step()

        n = batch.num_graphs

        m1, m3, m5 = metrics(
            logits,
            batch,
            targets
        )

        total_loss += (
            loss.item() * n
        )

        total_top1 += m1 * n
        total_top3 += m3 * n
        total_top5 += m5 * n

        total_graphs += n

    return {
        "loss": total_loss / total_graphs,
        "top1": total_top1 / total_graphs,
        "top3": total_top3 / total_graphs,
        "top5": total_top5 / total_graphs
    }


# ================================================================================================
# 17. VALIDATION FUNCTION
# ================================================================================================

@torch.no_grad()
def evaluate(
    model,
    loader
):

    model.eval()

    total_loss = 0.0
    total_graphs = 0

    total_top1 = 0.0
    total_top3 = 0.0
    total_top5 = 0.0

    for batch in loader:

        batch = batch.to(device)

        logits = model(batch)

        assert logits.shape == (
            batch.x.shape[0],
            1
        )

        assert torch.isfinite(
            logits
        ).all()

        targets = get_targets(
            batch
        )

        loss = graph_local_loss(
            logits,
            batch,
            targets
        )

        assert torch.isfinite(loss)

        n = batch.num_graphs

        m1, m3, m5 = metrics(
            logits,
            batch,
            targets
        )

        total_loss += (
            loss.item() * n
        )

        total_top1 += m1 * n
        total_top3 += m3 * n
        total_top5 += m5 * n

        total_graphs += n

    return {
        "loss": total_loss / total_graphs,
        "top1": total_top1 / total_graphs,
        "top3": total_top3 / total_graphs,
        "top5": total_top5 / total_graphs
    }


