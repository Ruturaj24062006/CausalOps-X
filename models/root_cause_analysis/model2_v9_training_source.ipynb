found_paths = []


def inspect_recursive(
    obj,
    path="ROOT",
    depth=0,
    max_depth=6
):

    if depth > max_depth:
        return

    if isinstance(obj, dict):

        for key, value in obj.items():

            key_lower = str(key).lower()

            current_path = (
                f"{path}.{key}"
            )

            if (
                key_lower in split_keywords
                or
                "train" in key_lower
                or
                "valid" in key_lower
                or
                "test" in key_lower
                or
                "split" in key_lower
            ):

                found_paths.append(
                    (
                        current_path,
                        type(value).__name__,
                        value
                    )
                )

            inspect_recursive(
                value,
                current_path,
                depth + 1,
                max_depth
            )

    elif isinstance(obj, list):

        for i, value in enumerate(
            obj[:5]
        ):

            inspect_recursive(
                value,
                f"{path}[{i}]",
                depth + 1,
                max_depth
            )


