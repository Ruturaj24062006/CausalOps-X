def train_one_epoch(
    model,
    loader,
    optimizer,
):

    model.train()

    total_loss = 0.0
    total_graphs = 0

    for batch in loader:

        # Graph tensors remain CPU until complete batch.
        batch = batch.to(device)

        optimizer.zero_grad(
            set_to_none=True
        )

        logits = model(batch)

        assert logits.ndim == 2
        assert logits.shape[0] == batch.x.shape[0]
        assert logits.shape[1] == 1

        targets = build_local_targets(
            batch
        )

        loss = graph_local_loss(
            logits,
            batch,
            targets
        )

        assert torch.isfinite(loss)

        loss.backward()

        optimizer.step()

        batch_graphs = batch.num_graphs

        total_loss += (
            loss.item()
            * batch_graphs
        )

        total_graphs += batch_graphs

    return total_loss / total_graphs


@torch.no_grad()
def evaluate(
    model,
    loader,
):

    model.eval()

    total_loss = 0.0
    total_graphs = 0

    top1 = 0
    top3 = 0
    top5 = 0

    for batch in loader:

        batch = batch.to(device)

        logits = model(batch)

        assert logits.ndim == 2
        assert logits.shape[0] == batch.x.shape[0]
        assert logits.shape[1] == 1

        targets = build_local_targets(
            batch
        )

        loss = graph_local_loss(
            logits,
            batch,
            targets
        )

        total_loss += (
            loss.item()
            * batch.num_graphs
        )

        total_graphs += batch.num_graphs

        ptr = batch.ptr

        for graph_idx in range(
            batch.num_graphs
        ):

            start = int(
                ptr[graph_idx].item()
            )

            end = int(
                ptr[graph_idx + 1].item()
            )

            scores = logits[
                start:end,
                0
            ]

            target = int(
                targets[
                    graph_idx
                ].item()
            )

            order = torch.argsort(
                scores,
                descending=True
            )

            rank = (
                order == target
            ).nonzero(
                as_tuple=False
            ).item() + 1

            if rank <= 1:
                top1 += 1

            if rank <= 3:
                top3 += 1

            if rank <= 5:
                top5 += 1

    return {
        "loss": total_loss / total_graphs,
        "top1": top1 / total_graphs,
        "top3": top3 / total_graphs,
        "top5": top5 / total_graphs,
        "graphs": total_graphs,
    }


