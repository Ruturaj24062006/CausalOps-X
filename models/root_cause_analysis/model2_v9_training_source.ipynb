                system
            ][case]
            for case in ordered_cases
        ]
    )

    variance = np.var(
        matrix,
        axis=0,
        ddof=0
    )

    mask = variance <= 1e-12

    zero_variance[
        system
    ] = {
        "count":
            int(mask.sum()),

        "total":
            int(matrix.shape[1])
    }

    print(
        f"{system}: "
        f"{int(mask.sum())}/"
        f"{matrix.shape[1]}"
    )

