def count_edge_like_objects(obj):

    total = 0
    locations = []

    if isinstance(obj, dict):

        for key, value in obj.items():

            key_lower = str(key).lower()

            if key_lower in EDGE_KEYS:

                if isinstance(value, list):

                    total += len(value)

                    locations.append(
                        (
                            str(key),
                            len(value)
                        )
                    )

                elif isinstance(value, dict):

                    total += len(value)

                    locations.append(
                        (
                            str(key),
                            len(value)
                        )
                    )

            total_nested, nested_locations = (
                count_edge_like_objects(value)
            )

            total += total_nested
            locations.extend(
                nested_locations
            )

    elif isinstance(obj, list):

        for item in obj:

            nested_total, nested_locations = (
                count_edge_like_objects(item)
            )

            total += nested_total
            locations.extend(
                nested_locations
            )

    return total, locations


