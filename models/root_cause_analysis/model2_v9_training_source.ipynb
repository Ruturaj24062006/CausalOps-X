class Model2V9(nn.Module):

    def __init__(
        self,
        node_input_dim=32,
        edge_input_dim=5,
        hidden_dim=128,
        num_layers=3,
        dropout=0.2
    ):

        super().__init__()

        self.node_input_dim = node_input_dim
        self.edge_input_dim = edge_input_dim
        self.hidden_dim = hidden_dim
        self.num_layers = num_layers
        self.dropout = dropout

        self.convs = nn.ModuleList()

        self.convs.append(
            GCNConv(
                node_input_dim,
                hidden_dim
            )
        )

        for _ in range(
            num_layers - 1
        ):
            self.convs.append(
                GCNConv(
                    hidden_dim,
                    hidden_dim
                )
            )

        self.dropout_layer = nn.Dropout(
            dropout
        )

        self.score_head = nn.Linear(
            hidden_dim,
            1
        )

    def forward(
        self,
        data
    ):

        x = data.x
        edge_index = data.edge_index

        for conv in self.convs:

            x = conv(
                x,
                edge_index
            )

            x = F.relu(x)

            x = self.dropout_layer(
                x
            )

        logits = self.score_head(
            x
        )

        return logits


