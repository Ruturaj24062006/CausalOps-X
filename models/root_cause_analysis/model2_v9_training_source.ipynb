# =============================================================================
# 3. METRIC COLUMN PARSER
# =============================================================================

def parse_metric_column(column):

    column = str(column)

    for family in sorted(
        FAMILIES,
        key=len,
        reverse=True
    ):

        suffix = "_" + family

        if column.endswith(
            suffix
        ):

            service = column[
                :-(len(suffix))
            ]

            if service:

                return service, family

    return None, None

