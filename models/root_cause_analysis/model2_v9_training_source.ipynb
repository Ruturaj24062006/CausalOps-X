def build_local_targets(batch):

    targets = []

    ptr = batch.ptr.detach().cpu()

    for graph_idx, case_id in enumerate(
        batch.case_id
    ):

        case_id = str(case_id)

        target = int(
            target_by_case[case_id]
        )

        start = int(
            ptr[graph_idx]
        )

        end = int(
            ptr[graph_idx + 1]
        )

        num_nodes = end - start

        assert (
            0 <= target < num_nodes
        )

        targets.append(target)

    return torch.tensor(
        targets,
        dtype=torch.long,
        device=batch.x.device
    )


