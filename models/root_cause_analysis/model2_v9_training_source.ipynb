import os
import json
import numpy as np
import pandas as pd

print("=" * 100)
print("CAUSALOPS X — MODEL 2 V9")
print("STEP 9 — TRACE-BASED EDGE FEATURE CONSTRUCTION")
print("=" * 100)

print("""
================================================================================
SAFETY
================================================================================

EDGE FEATURE CONSTRUCTION ONLY.

NO TRAINING.
NO FEATURE SELECTION.
NO FEATURE REDUCTION.
NO MODEL MODIFICATION.
NO CHECKPOINT MODIFICATION.

ONLY EXISTING STEP 8 TOPOLOGY EDGES ARE USED.

NO NEW EDGES WILL BE CREATED.
NO SERVICE RELATIONSHIPS WILL BE INVENTED.

best_model_v8.pth WILL NOT BE TOUCHED.
================================================================================
""")

# ----------------------------------------------------------------------------------------------------
# PATHS
# ----------------------------------------------------------------------------------------------------

ROOT = "/kaggle/working/rcaeval_re2"

STEP7 = "/kaggle/working/model2_v9_final_system_node_contract.json"
STEP8 = "/kaggle/working/model2_v9_final_graph_topology_contract.json"

OUTPUT = "/kaggle/working/model2_v9_final_edge_feature_contract.json"

assert os.path.isdir(ROOT), f"RE2 dataset not found: {ROOT}"
assert os.path.isfile(STEP7), f"STEP 7 contract not found: {STEP7}"
assert os.path.isfile(STEP8), f"STEP 8 contract not found: {STEP8}"

# ----------------------------------------------------------------------------------------------------
# LOAD CONTRACTS
# ----------------------------------------------------------------------------------------------------

with open(STEP7, "r", encoding="utf-8") as f:
    node_contract = json.load(f)

with open(STEP8, "r", encoding="utf-8") as f:
    topology_contract = json.load(f)

case_graphs = topology_contract["case_graphs"]

systems = [
    "Online Boutique",
    "Sock Shop",
    "Train Ticket"
]

# ----------------------------------------------------------------------------------------------------
# 1. EDGE FEATURE DEFINITION
# ----------------------------------------------------------------------------------------------------

print("=" * 100)
print("1. EDGE FEATURE DEFINITION")
print("=" * 100)

edge_feature_names = [
    "call_count",
    "mean_duration",
    "std_duration",
    "error_rate",
    "p90_duration"
]

for i, name in enumerate(edge_feature_names):
    print(f"{i}: {name}")

print("Edge feature dimension:", len(edge_feature_names))

assert len(edge_feature_names) == 5

# ----------------------------------------------------------------------------------------------------
# 2. TRACE SCHEMA VALIDATION
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("2. TRACE SCHEMA VALIDATION")
print("=" * 100)

required_columns = {
    "serviceName",
    "parentSpanID",
    "spanID",
    "duration",
    "statusCode"
}

trace_cases = sorted([
    case
    for case, graph in case_graphs.items()
    if graph["trace_available"]
])

trace_schema_failures = []
trace_read_failures = []

for idx, case in enumerate(trace_cases, 1):

    path = os.path.join(
        ROOT,
        case,
        "traces.parquet"
    )

    try:
        df = pd.read_parquet(path)

    except Exception as e:

        trace_read_failures.append({
            "case": case,
            "error": str(e)
        })

        continue

    missing = sorted(
        required_columns -
        set(df.columns)
    )

    if missing:

        trace_schema_failures.append({
            "case": case,
            "missing_columns": missing
        })

    if idx % 25 == 0 or idx == len(trace_cases):
        print(
            f"Validated traces: "
            f"{idx}/{len(trace_cases)}"
        )

print("Trace schema failures:", len(trace_schema_failures))
print("Trace read failures:", len(trace_read_failures))

assert len(trace_schema_failures) == 0
assert len(trace_read_failures) == 0

# ----------------------------------------------------------------------------------------------------
# 3. DURATION VALIDATION
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("3. TRACE DURATION VALIDATION")
print("=" * 100)

duration_failures = []

for case in trace_cases:

    path = os.path.join(
        ROOT,
        case,
        "traces.parquet"
    )

    df = pd.read_parquet(path)

    duration = pd.to_numeric(
        df["duration"],
        errors="coerce"
    )

    values = duration.to_numpy(
        dtype=float
    )

    invalid = ~np.isfinite(values)

    if invalid.any():

        duration_failures.append({
            "case": case,
            "invalid_values":
                int(invalid.sum())
        })

    negative = values < 0

    if negative.any():

        duration_failures.append({
            "case": case,
            "negative_values":
                int(negative.sum())
        })

print(
    "Duration validation failures:",
    len(duration_failures)
)

assert len(duration_failures) == 0

# ----------------------------------------------------------------------------------------------------
# 4. STATUS CODE NORMALIZATION
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("4. STATUS CODE NORMALIZATION")
print("=" * 100)

print("""
FIX:

statusCode may be loaded by pandas as nullable Int64.

Therefore we DO NOT use:

    fillna("")

Instead:

    pd.to_numeric(..., errors="coerce")

Missing values remain NaN and are treated as non-error.

Numeric statusCode >= 400 is treated as an error.
""")

status_values = set()

status_conversion_failures = []

for case in trace_cases:

    path = os.path.join(
        ROOT,
        case,
        "traces.parquet"
    )

    df = pd.read_parquet(path)

    raw_status = df["statusCode"]

    numeric_status = pd.to_numeric(
        raw_status,
        errors="coerce"
    )

    bad_conversion = (
        raw_status.notna()
        &
        numeric_status.isna()
    )

    if bad_conversion.any():

        status_conversion_failures.append({
            "case": case,
            "count":
                int(bad_conversion.sum())
        })

    for value in numeric_status.dropna().unique():

        status_values.add(
            int(value)
        )

print(
    "Unique numeric statusCode values:",
    len(status_values)
)

print(
    "Status values:",
    sorted(status_values)
)

print(
    "Status conversion failures:",
    len(status_conversion_failures)
)

assert len(status_conversion_failures) == 0

# ----------------------------------------------------------------------------------------------------
# 5. EDGE FEATURE RECOMPUTATION
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("5. RECOMPUTING EDGE FEATURES")
print("=" * 100)

case_edge_features = {}

feature_failures = []

processed = 0

for case in sorted(case_graphs.keys()):

    graph = case_graphs[case]

    # --------------------------------------------------------------------------------
    # TRACE-MISSING CASE
    # --------------------------------------------------------------------------------

    if not graph["trace_available"]:

        case_edge_features[case] = {
            "system":
                graph["system"],

            "trace_available":
                False,

            "edge_count":
                0,

            "edges":
                []
        }

        continue

    system = graph["system"]

    trace_path = os.path.join(
        ROOT,
        case,
        "traces.parquet"
    )

    df = pd.read_parquet(
        trace_path
    )

    # --------------------------------------------------------------------------------
    # SAFE FIELD NORMALIZATION
    # --------------------------------------------------------------------------------

    service_series = (
        df["serviceName"]
        .astype("string")
        .fillna("")
        .str.strip()
    )

    parent_series = (
        df["parentSpanID"]
        .astype("string")
        .fillna("")
        .str.strip()
    )

    span_series = (
        df["spanID"]
        .astype("string")
        .fillna("")
        .str.strip()
    )

    duration_series = pd.to_numeric(
        df["duration"],
        errors="coerce"
    )

    # IMPORTANT FIX:
    # statusCode is numeric/nullable in the dataset.
    # Convert directly to numeric.
    status_series = pd.to_numeric(
        df["statusCode"],
        errors="coerce"
    )

    # --------------------------------------------------------------------------------
    # SPAN -> SERVICE MAP
    # --------------------------------------------------------------------------------

    span_to_service = {}

    for span_id, service in zip(
        span_series,
        service_series
    ):

        span_id = str(span_id)
        service = str(service)

        if span_id and service:
            span_to_service[
                span_id
            ] = service

    # --------------------------------------------------------------------------------
    # APPROVED STEP 8 TOPOLOGY
    # --------------------------------------------------------------------------------

    approved_edges = {
        (
            edge["source_service"],
            edge["target_service"]
        )
        for edge in graph["edges"]
    }

    edge_records = {}

    # --------------------------------------------------------------------------------
    # RECOVER ONLY EXISTING STEP 8 EDGES
    # --------------------------------------------------------------------------------

    for (
        parent_span_id,
        child_service,
        duration,
        status
    ) in zip(
        parent_series,
        service_series,
        duration_series,
        status_series
    ):

        parent_span_id = str(
            parent_span_id
        )

        child_service = str(
            child_service
        )

        if not parent_span_id:
            continue

        parent_service = span_to_service.get(
            parent_span_id
        )

        if parent_service is None:
            continue

        pair = (
            parent_service,
            child_service
        )

        # NEVER create a new relationship.
        if pair not in approved_edges:
            continue

        if not np.isfinite(
            float(duration)
        ):
            continue

        if pair not in edge_records:

            edge_records[pair] = {
                "durations": [],
                "statuses": []
            }

        edge_records[pair][
            "durations"
        ].append(
            float(duration)
        )

        if pd.notna(status):
            edge_records[pair][
                "statuses"
            ].append(
                float(status)
            )

    # --------------------------------------------------------------------------------
    # BUILD FEATURES FOR APPROVED EDGES
    # --------------------------------------------------------------------------------

    final_edges = []

    for edge in graph["edges"]:

        source = edge[
            "source_service"
        ]

        target = edge[
            "target_service"
        ]

        pair = (
            source,
            target
        )

        record = edge_records.get(
            pair
        )

        if record is None:

            feature_failures.append({
                "case": case,
                "source_service": source,
                "target_service": target,
                "reason":
                    "No observed trace spans for approved topology edge"
            })

            continue

        durations = np.asarray(
            record["durations"],
            dtype=float
        )

        statuses = np.asarray(
            record["statuses"],
            dtype=float
        )

        if len(durations) == 0:

            feature_failures.append({
                "case": case,
                "source_service": source,
                "target_service": target,
                "reason":
                    "Empty duration array"
            })

            continue

        # --------------------------------------------------------------------------------
        # FIVE EDGE FEATURES
        # --------------------------------------------------------------------------------

        call_count = int(
            len(durations)
        )

        mean_duration = float(
            np.mean(durations)
        )

        std_duration = float(
            np.std(
                durations,
                ddof=0
            )
        )

        if len(statuses) > 0:

            error_rate = float(
                np.mean(
                    statuses >= 400
                )
            )

        else:

            error_rate = 0.0

        p90_duration = float(
            np.percentile(
                durations,
                90
            )
        )

        feature_vector = [
            call_count,
            mean_duration,
            std_duration,
            error_rate,
            p90_duration
        ]

        # --------------------------------------------------------------------------------
        # NUMERIC VALIDATION
        # --------------------------------------------------------------------------------

        if not all(
            np.isfinite(
                float(value)
            )
            for value in feature_vector
        ):

            feature_failures.append({
                "case": case,
                "source_service": source,
                "target_service": target,
                "reason":
                    "Non-finite feature vector",
                "feature_vector":
                    feature_vector
            })

            continue

        if call_count <= 0:
            feature_failures.append({
                "case": case,
                "source_service": source,
                "target_service": target,
                "reason":
                    "call_count <= 0"
            })

            continue

        if mean_duration < 0:
            feature_failures.append({
                "case": case,
                "source_service": source,
                "target_service": target,
                "reason":
                    "negative mean_duration"
            })

            continue

        if std_duration < 0:
            feature_failures.append({
                "case": case,
                "source_service": source,
                "target_service": target,
                "reason":
                    "negative std_duration"
            })

            continue

        if not (
            0.0 <= error_rate <= 1.0
        ):
            feature_failures.append({
                "case": case,
                "source_service": source,
                "target_service": target,
                "reason":
                    "error_rate outside [0,1]"
            })

            continue

        if p90_duration < 0:
            feature_failures.append({
                "case": case,
                "source_service": source,
                "target_service": target,
                "reason":
                    "negative p90_duration"
            })

            continue

        final_edges.append({

            "source_service":
                source,

            "target_service":
                target,

            "source_node":
                int(edge["source_node"]),

            "target_node":
                int(edge["target_node"]),

            "features": {

                "call_count":
                    call_count,

                "mean_duration":
                    mean_duration,

                "std_duration":
                    std_duration,

                "error_rate":
                    error_rate,

                "p90_duration":
                    p90_duration
            },

            "feature_vector":
                feature_vector
        })

    case_edge_features[case] = {

        "system":
            system,

        "trace_available":
            True,

        "edge_count":
            len(final_edges),

        "edges":
            sorted(
                final_edges,
                key=lambda x: (
                    x["source_node"],
                    x["target_node"]
                )
            )
    }

    processed += 1

    if (
        processed % 25 == 0
        or processed == len(trace_cases)
    ):

        print(
            f"Constructed edge features: "
            f"{processed}/{len(trace_cases)}"
        )

