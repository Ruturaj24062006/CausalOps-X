# =============================================================================

print("\n" + "=" * 100)
print("10. SYSTEM-LOCAL AVAILABILITY THRESHOLDS")
print("=" * 100)

for system in SYSTEMS:

    print("\n" + system)

    counter = system_presence[
        system
    ]

    for threshold in [
        1.00,
        0.95,
        0.90,
        0.80,
        0.75,
        0.50,
    ]:

        minimum = int(
            np.ceil(
                threshold * 90
            )
        )

        count = sum(
            presence >= minimum
            for presence in counter.values()
        )

        print(
