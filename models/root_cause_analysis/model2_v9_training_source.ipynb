class Model2V9CorrectedAudit(nn.Module):

    def __init__(
        self,
        node_input_dimension=32,
        hidden_dimension=128,
        dropout=0.2
    ):

        super().__init__()

        self.conv1 = GCNConv(
            node_input_dimension,
            hidden_dimension
        )

        self.conv2 = GCNConv(
            hidden_dimension,
            hidden_dimension
        )

        self.conv3 = GCNConv(
            hidden_dimension,
            hidden_dimension
        )

        self.dropout = nn.Dropout(dropout)

        self.score_head = nn.Linear(
            hidden_dimension,
            1
        )

    def forward_with_intermediates(self, data):

        x = data.x
        edge_index = data.edge_index

        z1 = self.conv1(
            x,
            edge_index
        )

        h1 = torch.relu(z1)

        h1d = self.dropout(h1)

        z2 = self.conv2(
            h1d,
            edge_index
        )

        h2 = torch.relu(z2)

        h2d = self.dropout(h2)

        z3 = self.conv3(
            h2d,
            edge_index
        )

        logits = self.score_head(z3)

        return {
            "input": x,
            "conv1_raw": z1,
            "conv1_relu": h1,
            "conv2_raw": z2,
            "conv2_relu": h2,
            "conv3_raw": z3,
            "logits": logits
        }

    def forward(self, data):

        return self.forward_with_intermediates(data)["logits"]


