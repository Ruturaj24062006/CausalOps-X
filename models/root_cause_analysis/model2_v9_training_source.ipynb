def build_local_targets(batch):

    targets = []

    ptr = batch.ptr.detach().cpu()

    case_ids = batch.case_id

    for graph_idx, case_id in enumerate(case_ids):

        case_id = str(case_id)

        target_local = int(
            target_by_case[case_id]
        )

        num_nodes = int(
            ptr[graph_idx + 1]
            - ptr[graph_idx]
        )

        assert (
            0 <= target_local < num_nodes
        )

        targets.append(
            target_local
        )

    return torch.tensor(
        targets,
        dtype=torch.long,
        device=batch.x.device
    )


