invalid_node_index = []
unknown_system = []

system_counts = Counter()
root_counts = Counter()

for i, (case_id, record) in enumerate(
    case_records.items(),
    start=1
):

    system = record["system"]

    if system not in node_orders:

        unknown_system.append({
            "case_id": case_id,
            "system": system,
        })

        continue

    root_service = record["root_cause_service"]

    if root_service is None:

        missing_root_service.append(
            case_id
        )

        continue

    root_service = str(
        root_service
    ).strip()

    if root_service == "":

        missing_root_service.append(
            case_id
        )

        continue

    nodes = node_orders[system]

    if root_service not in nodes:

        unknown_root_service.append({
            "case_id": case_id,
            "system": system,
            "root_cause_service": root_service,
        })

        continue

    target_node_index = nodes.index(
        root_service
    )

    if not (
        0 <= target_node_index < len(nodes)
    ):

        invalid_node_index.append({
            "case_id": case_id,
            "target_node_index": target_node_index,
        })

        continue

    target_manifest[case_id] = {
        "case_id": case_id,
        "system": system,
        "root_cause_service": root_service,
        "target_node_index": target_node_index,
    }

    system_counts[system] += 1

    root_counts[
        (system, root_service)
    ] += 1

