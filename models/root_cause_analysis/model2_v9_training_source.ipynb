# =============================================================================
# 3. IDENTIFY RAW METRIC COLUMNS
# =============================================================================

print("\n" + "=" * 100)
print("2. RAW METRIC COLUMN DISCOVERY")
print("=" * 100)

def classify_metric_column(column):

    column = str(column)

    if column == "time":
        return None

    for family in FAMILIES:

        suffix = "_" + family

        if column.endswith(suffix):
            return family

    return None


all_metric_columns = set()

family_columns = defaultdict(set)

case_metric_counts = []

for idx, record in enumerate(
    valid_records,
    start=1
):

    case = record["case"]

    path = os.path.join(
        ROOT,
        case,
        "metrics.parquet"
    )

    df = pd.read_parquet(path)

    case_metrics = []

    for column in df.columns:

        family = classify_metric_column(
            column
        )

        if family is not None:

            column = str(column)

            case_metrics.append(
                column
            )

            all_metric_columns.add(
                column
            )

            family_columns[
                family
            ].add(column)

    case_metric_counts.append(
        len(case_metrics)
    )

    if idx % 25 == 0 or idx == len(valid_records):
        print(
            f"Scanned {idx}/{len(valid_records)}"
