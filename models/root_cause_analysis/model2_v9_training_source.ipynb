# 9. PRODUCTION INFERENCE FUNCTION
# ================================================================================================

@torch.no_grad()
def production_inference(graph):

    model.eval()

    # Never modify original graph.
    runtime_graph = Data(
        x=graph.x.clone(),
        edge_index=graph.edge_index.clone(),
        edge_attr=graph.edge_attr.clone(),
    )

    # Apply training-only scaler to node features.
    x_np = runtime_graph.x.cpu().numpy()

    x_scaled = scaler.transform(x_np)

    runtime_graph.x = torch.tensor(
        x_scaled,
        dtype=torch.float32
    )

    scores = model(runtime_graph)

    assert scores.ndim == 2
    assert scores.shape[0] == runtime_graph.x.shape[0]
    assert scores.shape[1] == 1
    assert torch.isfinite(scores).all()

    predicted_local_node = int(
        torch.argmax(scores[:, 0]).item()
    )

    return predicted_local_node, scores

