# ================================================================================================
# 19. GRAPH-LOCAL LOSS
# ================================================================================================

def graph_local_loss(
    logits,
    batch,
    targets,
):

    assert logits.ndim == 2
    assert logits.shape[1] == 1

    graph_losses = []

    ptr = batch.ptr

    num_graphs = batch.num_graphs

    for graph_idx in range(num_graphs):

        start = int(
            ptr[graph_idx].item()
        )

        end = int(
            ptr[graph_idx + 1].item()
        )

        graph_logits = logits[
            start:end,
            0
        ].unsqueeze(0)

        graph_target = targets[
            graph_idx
        ].view(1)

        loss_i = criterion(
            graph_logits,
            graph_target
        )

        graph_losses.append(
            loss_i
        )

    return torch.stack(
        graph_losses
    ).mean()


