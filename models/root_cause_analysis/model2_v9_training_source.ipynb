assert step3["cases"] == 270
assert step3["derived_feature_count"] == 2204

records = step2["records"]

assert len(records) == 270

print("=" * 100)
print("1. INPUT VALIDATION")
print("=" * 100)

print(
    "Cases:",
    len(records)
)

