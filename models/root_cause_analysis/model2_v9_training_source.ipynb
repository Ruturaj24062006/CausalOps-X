                        type(value).__name__,
                        value
                    )
                )

            find_node_keys(
                value,
                path + "." + str(key)
            )

    elif isinstance(obj, list):

        for i, value in enumerate(obj):

            find_node_keys(
                value,
                path + f"[{i}]"
            )


