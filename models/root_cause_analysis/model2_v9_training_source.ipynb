        raw_missingness[
            system
        ]["missing_percentage"]
    )

# ----------------------------------------------------------------------------------------------------
# IMPUTATION
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("9. SYSTEM-WISE MEDIAN IMPUTATION")
print("=" * 100)

imputation_values = {}

for system in expected_systems:

    ordered_cases = sorted(
        system_matrices[system]
    )

    matrix = np.vstack(
        [
            system_matrices[
                system
            ][case]
            for case in ordered_cases
        ]
    )

    medians = np.zeros(
        matrix.shape[1],
        dtype=np.float64
    )

    for col in range(
        matrix.shape[1]
    ):

        values = matrix[:, col]

        finite = values[
            np.isfinite(values)
        ]

        if len(finite) > 0:

            medians[col] = float(
                np.median(finite)
            )

        else:

            medians[col] = 0.0

    missing = ~np.isfinite(
        matrix
    )

    rows, cols = np.where(
        missing
    )

    matrix[
        rows,
        cols
    ] = medians[cols]

    assert np.isfinite(
        matrix
    ).all()

    for row, case in enumerate(
        ordered_cases
    ):

        system_matrices[
            system
        ][case] = matrix[row]

    imputation_values[
        system
    ] = medians

    print(
        f"{system}: "
        f"{int(missing.sum())} values imputed"
    )

# ----------------------------------------------------------------------------------------------------
