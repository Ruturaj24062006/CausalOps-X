# Recover validation case IDs without assuming a specific
# internal manifest layout.

def recover_validation_cases(obj):

    if isinstance(obj, dict):

        # Direct validation list
        for key in [
            "validation",
            "val",
            "validation_cases",
            "val_cases"
        ]:

            value = obj.get(key)

            if isinstance(value, list):
                return value

        # System-wise split
        for key in [
            "split_by_system",
            "by_system",
            "systems",
            "system_splits"
        ]:

            value = obj.get(key)

            if isinstance(value, dict):

                collected = []

                for system_name, system_split in value.items():

                    if not isinstance(system_split, dict):
                        continue

                    for key2 in [
                        "validation",
                        "val",
                        "validation_cases",
                        "val_cases"
                    ]:

                        value2 = system_split.get(key2)

                        if isinstance(value2, list):
                            collected.extend(value2)
                            break

                if collected:
                    return collected

        # Recursive fallback
        for value in obj.values():

            result = recover_validation_cases(value)

            if result is not None:
                return result

    return None


