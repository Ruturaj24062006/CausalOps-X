def inspect_recursive(
    obj,
    path="ROOT",
    depth=0,
    max_depth=6
):

    if depth > max_depth:
        return

    if isinstance(obj, dict):

        for key, value in obj.items():

            current_path = (
                f"{path}.{key}"
            )

            if isinstance(value, list):

                print(
                    f"{current_path} -> "
                    f"type=list, "
                    f"length={len(value)}"
                )

                if len(value) > 0:

                    print(
                        f"{current_path}[0] -> "
                        f"type={type(value[0]).__name__}"
                    )

                    if isinstance(
                        value[0],
                        (dict, list)
                    ):

                        inspect_recursive(
                            value[0],
                            f"{current_path}[0]",
                            depth + 1,
                            max_depth
                        )

            elif isinstance(value, dict):

                print(
                    f"{current_path} -> type=dict"
                )

                inspect_recursive(
                    value,
                    current_path,
                    depth + 1,
                    max_depth
                )

            else:

                if any(
                    token in key.lower()
                    for token in [
                        "train",
                        "validation",
                        "val",
                        "test",
                        "split",
                        "case"
                    ]
                ):

                    print(
                        f"{current_path} -> "
                        f"type={type(value).__name__}, "
                        f"value={repr(value)[:300]}"
                    )


inspect_recursive(
