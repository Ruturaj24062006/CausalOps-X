class Model2V9(torch.nn.Module):

    def __init__(
        self,
        node_input_dim=32,
        edge_input_dim=5,
        hidden_dim=128,
        num_layers=3,
        dropout=0.2
    ):

        super().__init__()

        from torch_geometric.nn import GCNConv

        self.convs = torch.nn.ModuleList()

        self.convs.append(
            GCNConv(
                node_input_dim,
                hidden_dim
            )
        )

        for _ in range(
            num_layers - 1
        ):

            self.convs.append(
                GCNConv(
                    hidden_dim,
                    hidden_dim
                )
            )

        self.dropout = torch.nn.Dropout(
            dropout
        )

        self.score_head = torch.nn.Linear(
            hidden_dim,
            1
        )

    def forward(self, data):

        x = data.x
        edge_index = data.edge_index

        for conv in self.convs:

            x = conv(
                x,
                edge_index
            )

            x = torch.relu(x)

            x = self.dropout(x)

        logits = self.score_head(x)

        return logits


