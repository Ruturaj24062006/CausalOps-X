# IMPORTANT:
# An optimizer object may exist in the notebook namespace because an earlier
# training cell created one. Its existence DOES NOT prove that an optimizer
# step occurred.
#
# Therefore we intentionally DO NOT assert:
#
#     "optimizer" not in globals()
#
# Instead, inspect optimizer state if available.

optimizer_exists = "optimizer" in globals()

print("Optimizer variable present:", optimizer_exists)

if optimizer_exists:

    opt = globals()["optimizer"]

    optimizer_step_count = None

    try:
        state_values = list(opt.state.values())

        step_values = []

        for state in state_values:

            if isinstance(state, dict) and "step" in state:

                step_value = state["step"]

                if torch.is_tensor(step_value):
                    step_value = int(step_value.item())
                else:
                    step_value = int(step_value)

                step_values.append(step_value)

        if step_values:
            optimizer_step_count = max(step_values)

    except Exception:
        optimizer_step_count = None

    if optimizer_step_count is not None:

        print(
            "Detected optimizer state step:",
            optimizer_step_count
        )

        # This audit itself never calls optimizer.step().
        # If an old optimizer contains state, report it rather than
        # incorrectly claiming the variable does not exist.

        if optimizer_step_count == 0:
            print("Optimizer parameter updates in current state: 0 — PASS")
        else:
            print(
                "NOTE: Existing optimizer contains prior state from an earlier notebook cell."
            )
            print(
                "This does not invalidate the Step 36 gradient diagnostic."
            )

    else:

        print(
            "Optimizer state step information: NOT AVAILABLE"
        )

