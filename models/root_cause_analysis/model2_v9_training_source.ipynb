]


def normalize_case_list(value):

    if not isinstance(value, list):
        return None

    if len(value) == 0:
        return []

    if all(isinstance(x, str) for x in value):
        return value

    return None


def find_named_split(obj, wanted):

    """
    Recursively search for a list associated with a split name.

    This handles Step 17B manifest nesting without assuming
    one particular JSON structure.
    """

    if isinstance(obj, dict):

        for key, value in obj.items():

            key_lower = str(key).lower()

            if key_lower in wanted:

                result = normalize_case_list(value)

                if result is not None:
                    return result

            result = find_named_split(value, wanted)

            if result is not None:
                return result

    elif isinstance(obj, list):

        for item in obj:

            result = find_named_split(item, wanted)

            if result is not None:
                return result

    return None


# =================================================================================================
# 7. RECOVER SYSTEM-WISE SPLITS
# =================================================================================================

system_splits = {}

for system in SYSTEMS:

    # First try direct system entry.
    system_obj = split_manifest.get(system)

    if isinstance(system_obj, dict):

        train = find_named_split(
            system_obj,
            {"train", "train_cases", "training"}
        )

        validation = find_named_split(
            system_obj,
            {"validation", "val", "validation_cases"}
        )

        test = find_named_split(
            system_obj,
            {"test", "test_cases"}
        )

    else:

        train = None
        validation = None
        test = None

    # If direct lookup failed, search recursively inside entire manifest
    # for system-specific structures.
    if train is None or validation is None or test is None:

        def find_system_object(obj):

            if isinstance(obj, dict):

                if system in obj and isinstance(obj[system], dict):
                    return obj[system]

                for value in obj.values():
                    result = find_system_object(value)

                    if result is not None:
                        return result

            elif isinstance(obj, list):

                for value in obj:
                    result = find_system_object(value)

                    if result is not None:
                        return result

            return None

        system_obj = find_system_object(split_manifest)

        if isinstance(system_obj, dict):

            train = find_named_split(
                system_obj,
                {"train", "train_cases", "training"}
            )

            validation = find_named_split(
                system_obj,
                {"validation", "val", "validation_cases"}
            )

            test = find_named_split(
                system_obj,
                {"test", "test_cases"}
            )

    assert train is not None, f"{system}: train split not recovered"
    assert validation is not None, f"{system}: validation split not recovered"
    assert test is not None, f"{system}: test split not recovered"

    system_splits[system] = {
        "train": train,
        "validation": validation,
        "test": test,
    }


