# =============================================================================

STATISTICS = [
    "mean",
    "std",
    "min",
    "max",
]

FAMILIES = [
    "cpu",
    "mem",
    "diskio",
    "socket",
    "workload",
    "error",
    "latency-50",
    "latency-90",
]

def classify_metric_column(column):

    column = str(column)

    if column == "time":
        return None

    for family in FAMILIES:

        if column.endswith(
            "_" + family
        ):
            return family

    return None


print("\n" + "=" * 100)
print("2. REBUILDING CASE FEATURE MATRICES")
print("=" * 100)

case_vectors = {}
feature_presence = Counter()

for idx, record in enumerate(
    records,
    start=1
):

    case = record["case"]

    path = os.path.join(
        ROOT,
        case,
        "metrics.parquet"
    )

    df = pd.read_parquet(path)

    vector = {}

    metric_columns = [
        str(c)
        for c in df.columns
        if classify_metric_column(c)
        is not None
    ]

    for column in sorted(metric_columns):

        series = pd.to_numeric(
            df[column],
            errors="coerce"
        )

        values = {

            "mean":
                series.mean(),

            "std":
                series.std(
                    ddof=1
                ),

            "min":
                series.min(),

            "max":
                series.max(),
        }

        for stat, value in values.items():

            feature = (
                f"{column}__{stat}"
            )

            vector[feature] = (
                float(value)
                if pd.notna(value)
                and np.isfinite(value)
                else np.nan
            )

            feature_presence[
                feature
            ] += 1

    case_vectors[case] = vector

    if idx % 25 == 0 or idx == len(records):

        print(
            f"Processed {idx}/{len(records)}"
        )

# =============================================================================
# 3. FEATURE AVAILABILITY DISTRIBUTION
# =============================================================================

print("\n" + "=" * 100)
print("3. FEATURE AVAILABILITY DISTRIBUTION")
print("=" * 100)

universe = sorted(
    feature_presence.keys()
)

print(
    "Feature universe:",
    len(universe)
)

availability = Counter(
    feature_presence.values()
)

for count, n_features in sorted(
    availability.items()
):

    print(
        f"Present in {count:3d}/270 cases:"
        f" {n_features:4d} features"
    )

# =============================================================================
# 4. DEFINE AVAILABILITY THRESHOLDS
# =============================================================================

print("\n" + "=" * 100)
print("4. AVAILABILITY THRESHOLD ANALYSIS")
print("=" * 100)

thresholds = [
    1.00,
    0.95,
    0.90,
    0.80,
    0.75,
    0.50,
    0.25,
]

threshold_results = {}

for threshold in thresholds:

    minimum_cases = int(
        np.ceil(
            threshold
            * len(records)
        )
    )

    selected = [
        feature
        for feature in universe
        if feature_presence[feature]
        >= minimum_cases
    ]

    threshold_results[
        str(threshold)
    ] = {

        "minimum_cases":
            minimum_cases,

        "feature_count":
            len(selected),
    }

    print(
        f"{threshold*100:5.1f}% "
        f"-> >= {minimum_cases:3d} cases "
        f"-> {len(selected):4d} features"
    )

# =============================================================================
# 5. CANONICAL THRESHOLD
# =============================================================================

# We use 75% availability as the initial
# deterministic engineering threshold.
#
# This is NOT model-selected.
# It is a raw-data availability rule.

CANONICAL_THRESHOLD = 0.75

minimum_cases = int(
    np.ceil(
        CANONICAL_THRESHOLD
        * len(records)
    )
)

canonical_features = sorted([

    feature

    for feature in universe

    if feature_presence[feature]
    >= minimum_cases

])

print("\n" + "=" * 100)
print("5. CANONICAL FEATURE SPACE")
print("=" * 100)

print(
    "Availability threshold:",
    f"{CANONICAL_THRESHOLD * 100:.1f}%"
)

print(
    "Minimum cases required:",
    minimum_cases
)

print(
    "Canonical feature count:",
    len(canonical_features)
)

# =============================================================================
# 6. MISSINGNESS AFTER CANONICALIZATION
# =============================================================================

print("\n" + "=" * 100)
print("6. CANONICAL FEATURE MISSINGNESS")
print("=" * 100)

missing_values = 0
total_values = (
    len(records)
    * len(canonical_features)
)

feature_missing_counts = {}

for feature in canonical_features:

    missing = 0

    for case in case_vectors:

        value = case_vectors[
            case
        ].get(
            feature,
            np.nan
        )

        if (
            value is None
            or not np.isfinite(
                float(value)
            )
        ):

            missing += 1

    feature_missing_counts[
        feature
    ] = missing

    missing_values += missing

print(
    "Total matrix values:",
    total_values
)

print(
    "Missing/non-finite values:",
    missing_values
)

print(
    "Missing percentage:",
    (
        100
        * missing_values
        / total_values
        if total_values
        else 0
    )
)

# =============================================================================
# 7. DETERMINISTIC IMPUTATION POLICY
# =============================================================================

print("\n" + "=" * 100)
print("7. IMPUTATION POLICY")
print("=" * 100)

print("""
Policy:

For every canonical feature:

1. Collect finite values from all 270 cases.
2. Compute the median using ALL CASES.
3. Replace missing/non-finite values with that median.
4. Freeze the resulting imputation value.

IMPORTANT:

This is preprocessing construction only.
No labels are used.
No root-cause information is used.
No fault information is used.
""")

imputation_values = {}

for feature in canonical_features:

    values = []

    for case in case_vectors:

        value = case_vectors[
            case
        ].get(
            feature,
            np.nan
        )

        if (
            value is not None
            and np.isfinite(
                float(value)
            )
        ):

            values.append(
                float(value)
            )

    if not values:

        raise RuntimeError(
            "Canonical feature has no "
            "finite values: "
            + feature
        )

    median = float(
        np.median(values)
    )

    imputation_values[
        feature
    ] = median

print(
    "Imputation values created:",
    len(imputation_values)
)

# =============================================================================
# 8. BUILD FIXED MATRIX
# =============================================================================

print("\n" + "=" * 100)
print("8. BUILDING FIXED FEATURE MATRIX")
print("=" * 100)

X = np.zeros(
    (
        len(records),
        len(canonical_features)
    ),
    dtype=np.float32
)

case_order = []

for row_index, record in enumerate(
    records
):

    case = record["case"]

    case_order.append(case)

    vector = case_vectors[
        case
    ]

    for column_index, feature in enumerate(
        canonical_features
    ):

        value = vector.get(
            feature,
            np.nan
        )

        if (
            value is None
            or not np.isfinite(
                float(value)
            )
        ):

            value = imputation_values[
                feature
            ]

        X[
            row_index,
            column_index
        ] = float(value)

print(
    "Matrix shape:",
    X.shape
)

# =============================================================================
# 9. FINITE VALIDATION
# =============================================================================

print("\n" + "=" * 100)
print("9. MATRIX VALIDATION")
print("=" * 100)

assert X.shape == (
    len(records),
    len(canonical_features)
)

assert np.isfinite(
    X
).all()

print(
