# =============================================================================
# 2. TRACE AVAILABILITY
# =============================================================================

print("\n" + "=" * 100)
print("2. TRACE AVAILABILITY")
print("=" * 100)

trace_cases = []
missing_trace_cases = []

for record in records:

    case = record["case"]

    trace_path = os.path.join(
        ROOT,
        case,
        "traces.parquet"
    )

    if os.path.isfile(trace_path):

        trace_cases.append(case)

    else:

        missing_trace_cases.append(case)

print("Cases with traces:", len(trace_cases))
print("Cases without traces:", len(missing_trace_cases))

# =============================================================================
# 3. PARENT-SPAN GRAPH RECOVERY
# =============================================================================

print("\n" + "=" * 100)
print("3. RECOVERING PARENT-SPAN RELATIONSHIPS")
print("=" * 100)

case_edges = {}
case_edge_counts = {}
case_span_counts = {}
case_orphan_parent_counts = {}
case_self_edge_counts = {}
case_invalid_rows = {}

global_edges = Counter()

system_edges = defaultdict(Counter)

trace_failures = []

for index, case in enumerate(
    trace_cases,
    start=1
):

    path = os.path.join(
        ROOT,
        case,
        "traces.parquet"
    )

    try:

        df = pd.read_parquet(path)

        required_columns = {
            "traceID",
            "spanID",
            "parentSpanID",
            "serviceName",
        }

        missing = (
            required_columns
            - set(df.columns)
        )

        if missing:

            trace_failures.append({
                "case": case,
                "reason": (
                    "missing columns"
                ),
                "columns": sorted(missing),
            })

            case_edges[case] = []
            case_edge_counts[case] = 0
            case_span_counts[case] = len(df)
            case_orphan_parent_counts[case] = 0
            case_self_edge_counts[case] = 0
            case_invalid_rows[case] = 0

            continue

        case_span_counts[case] = len(df)

        # -------------------------------------------------------------
        # Build spanID -> service mapping.
        #
        # Include traceID because span IDs should be interpreted
        # within their trace.
        # -------------------------------------------------------------

        span_to_service = {}

        duplicate_span_ids = 0

        for _, row in df.iterrows():

            trace_id = row["traceID"]
            span_id = row["spanID"]
            service = row["serviceName"]

            if (
                pd.isna(trace_id)
                or pd.isna(span_id)
                or pd.isna(service)
            ):
                continue

            trace_id = str(trace_id)
            span_id = str(span_id)
            service = str(service).strip()

            key = (
                trace_id,
                span_id
            )

            if key in span_to_service:

                duplicate_span_ids += 1

            else:

                span_to_service[
                    key
                ] = service

        # -------------------------------------------------------------
        # Recover parent service -> child service.
        # -------------------------------------------------------------

        local_edges = Counter()

        orphan_parents = 0
        self_edges = 0
        invalid_rows = 0

        for _, row in df.iterrows():

            trace_id = row["traceID"]
            span_id = row["spanID"]
            parent_span_id = row["parentSpanID"]
            child_service = row["serviceName"]

            if (
                pd.isna(trace_id)
                or pd.isna(span_id)
                or pd.isna(child_service)
            ):

                invalid_rows += 1
                continue

            trace_id = str(trace_id)
            span_id = str(span_id)
            child_service = str(
                child_service
            ).strip()

            # Root spans generally have null/empty parent.
            if (
                pd.isna(parent_span_id)
                or str(parent_span_id).strip() == ""
                or str(parent_span_id).lower()
                in {
                    "nan",
                    "none",
                    "null",
                }
            ):

                continue

            parent_span_id = str(
                parent_span_id
            ).strip()

            parent_key = (
                trace_id,
                parent_span_id
            )

            parent_service = (
                span_to_service.get(
                    parent_key
                )
            )

            # Parent span is not present in this parquet.
            if parent_service is None:

                orphan_parents += 1
                continue

            if (
                not parent_service
                or not child_service
            ):

                invalid_rows += 1
                continue

            if (
                parent_service
                == child_service
            ):

                self_edges += 1
                continue

            edge = (
                parent_service,
                child_service
            )

            local_edges[edge] += 1

        # -------------------------------------------------------------
        # Store unique topology edges.
        # -------------------------------------------------------------

        unique_edges = sorted(
            local_edges.keys()
        )

        case_edges[case] = [
            {
                "source_service": source,
                "target_service": target,
                "call_count": int(
                    local_edges[
                        (
                            source,
                            target
                        )
                    ]
                ),
            }

            for source, target
            in unique_edges
        ]

        case_edge_counts[case] = len(
            unique_edges
        )

        case_orphan_parent_counts[
            case
        ] = orphan_parents

        case_self_edge_counts[
            case
        ] = self_edges

        case_invalid_rows[
            case
        ] = invalid_rows

        # -------------------------------------------------------------
        # Global counters.
        # -------------------------------------------------------------

        system = None

        for record in records:

            if record["case"] == case:

                system = record["system"]
                break

        for edge, count in local_edges.items():

            global_edges[edge] += count

            if system is not None:

                system_edges[
                    system
                ][edge] += count

    except Exception as exc:

        trace_failures.append({
            "case": case,
            "reason": str(exc),
        })

        case_edges[case] = []
        case_edge_counts[case] = 0
        case_span_counts[case] = 0
        case_orphan_parent_counts[case] = 0
        case_self_edge_counts[case] = 0
        case_invalid_rows[case] = 0

    if (
        index % 25 == 0
        or index == len(trace_cases)
    ):

        print(
            f"Processed "
            f"{index}/{len(trace_cases)}"
        )

