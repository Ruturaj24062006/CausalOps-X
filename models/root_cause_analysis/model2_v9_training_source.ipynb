def scale_graph(graph):

    g = graph.clone()

    x_np = (
        g.x
        .detach()
        .cpu()
        .numpy()
    )

    scaled_x = scaler.transform(
        x_np
    )

    assert scaled_x.shape == (
        x_np.shape
    )

    assert scaled_x.shape[1] == 32

    assert np.isfinite(
        scaled_x
    ).all()

    g.x = torch.tensor(
        scaled_x,
        dtype=torch.float32
    )

    return g


