class Model2V9Corrected(nn.Module):

    def __init__(
        self,
        node_input_dimension=32,
        edge_input_dimension=5,
        hidden_dimension=128,
        num_gnn_layers=3,
        dropout=0.2
    ):

        super().__init__()

        self.conv1 = GCNConv(
            node_input_dimension,
            hidden_dimension
        )

        self.conv2 = GCNConv(
            hidden_dimension,
            hidden_dimension
        )

        self.conv3 = GCNConv(
            hidden_dimension,
            hidden_dimension
        )

        self.relu = nn.ReLU()

        self.dropout = nn.Dropout(
            dropout
        )

        self.score_head = nn.Linear(
            hidden_dimension,
            1
        )

    def forward(self, data):

        x = data.x
        edge_index = data.edge_index

        x = self.conv1(
            x,
            edge_index
        )

        x = self.relu(x)
        x = self.dropout(x)

        x = self.conv2(
            x,
            edge_index
        )

        x = self.relu(x)
        x = self.dropout(x)

        # FINAL GCN HAS NO RELU
        x = self.conv3(
            x,
            edge_index
        )

        logits = self.score_head(x)

        return logits


