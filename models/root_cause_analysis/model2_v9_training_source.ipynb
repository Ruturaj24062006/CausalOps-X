# =============================================================================
# CAUSALOPS X — MODEL 2 V9
# STEP 4B — SYSTEM-AWARE FEATURE SPACE ANALYSIS
# =============================================================================

import os
import json
import numpy as np
import pandas as pd
from collections import defaultdict, Counter

print("=" * 100)
print("CAUSALOPS X — MODEL 2 V9")
print("STEP 4B — SYSTEM-AWARE FEATURE SPACE ANALYSIS")
print("=" * 100)

ROOT = "/kaggle/working/rcaeval_re2"

AUDIT_PATH = (
    "/kaggle/working/"
    "model2_v9_step2_case_target_audit.json"
)

assert os.path.isdir(ROOT)
assert os.path.isfile(AUDIT_PATH)

# =============================================================================
# SAFETY
# =============================================================================

print("""
================================================================================
SAFETY
================================================================================

ANALYSIS ONLY.

NO TRAINING.
NO FEATURE SELECTION BASED ON TARGETS.
NO FEATURE REDUCTION.
NO GRAPH CONSTRUCTION.
NO MODEL MODIFICATION.

best_model_v8.pth WILL NOT BE TOUCHED.
""")

# =============================================================================
# 1. LOAD AUDIT
# =============================================================================

with open(
    AUDIT_PATH,
    "r",
    encoding="utf-8"
) as f:
    audit = json.load(f)

records = audit["records"]

assert len(records) == 270

SYSTEMS = [
    "Online Boutique",
    "Sock Shop",
    "Train Ticket",
]

FAMILIES = [
    "cpu",
    "mem",
    "diskio",
    "socket",
    "workload",
    "error",
    "latency-50",
    "latency-90",
]

STATISTICS = [
    "mean",
    "std",
    "min",
    "max",
]

# =============================================================================
# 2. CASE GROUPS
# =============================================================================

system_cases = defaultdict(list)

for record in records:

    system_cases[
        record["system"]
    ].append(
        record["case"]
    )

print("=" * 100)
print("1. SYSTEM CASE COUNTS")
print("=" * 100)

for system in SYSTEMS:

    print(
        f"{system:20s}: "
        f"{len(system_cases[system])}"
    )

# =============================================================================
# 3. BUILD DERIVED FEATURE SET PER CASE
# =============================================================================

def classify_metric_column(column):

    column = str(column)

    for family in FAMILIES:

        if column.endswith(
            "_" + family
        ):
            return family

    return None


print("\n" + "=" * 100)
print("2. BUILDING SYSTEM FEATURE SETS")
print("=" * 100)

case_features = {}

for index, record in enumerate(
    records,
    start=1
):

    case = record["case"]

    path = os.path.join(
        ROOT,
        case,
        "metrics.parquet"
    )

    df = pd.read_parquet(path)

    features = set()

    for column in df.columns:

        family = classify_metric_column(
            column
        )

        if family is None:
            continue

        column = str(column)

        for stat in STATISTICS:

            features.add(
                f"{column}__{stat}"
            )

    case_features[case] = features

    if index % 25 == 0 or index == len(records):

        print(
            f"Processed {index}/{len(records)}"
        )

# =============================================================================
# 4. SYSTEM UNION / INTERSECTION
# =============================================================================

print("\n" + "=" * 100)
print("3. SYSTEM FEATURE UNION / INTERSECTION")
print("=" * 100)

system_union = {}
system_intersection = {}

for system in SYSTEMS:

    feature_sets = [
        case_features[case]
        for case in system_cases[system]
    ]

    union = set().union(
        *feature_sets
    )

    intersection = set.intersection(
        *feature_sets
    )

    system_union[system] = union
    system_intersection[system] = intersection

    print("\n" + system)

    print(
        "Union:",
        len(union)
    )

    print(
        "Intersection:",
        len(intersection)
    )

    print(
        "Variable:",
        len(
            union - intersection
        )
    )

# =============================================================================
# 5. SYSTEM FEATURE PRESENCE DISTRIBUTION
# =============================================================================

print("\n" + "=" * 100)
print("4. SYSTEM FEATURE PRESENCE DISTRIBUTION")
print("=" * 100)

system_presence = {}

for system in SYSTEMS:

    counter = Counter()

    for case in system_cases[system]:

        for feature in case_features[case]:

            counter[feature] += 1

    system_presence[system] = counter

    print("\n" + system)

