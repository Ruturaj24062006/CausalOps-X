        )

        family = None

        for candidate in FAMILIES:

            if base.endswith(
                "_" + candidate
            ):

                family = candidate
                break

        if family is None:
            continue

        service = base[
            :-(len(family) + 1)
        ]

        normalized[
            (family, stat)
        ].add(
            service
        )

for family in FAMILIES:

    print(
        f"\n{family}"
    )

    for stat in STATISTICS:

        services = sorted(
            normalized[
