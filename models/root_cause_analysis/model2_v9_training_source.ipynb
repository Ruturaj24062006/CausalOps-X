def train_one_epoch(
    model,
    loader,
    optimizer,
    device
):

    model.train()

    total_loss = 0.0
    graph_count = 0

    for batch in loader:

        # Graphs remain CPU until the
        # complete batch is formed.
        batch = batch.to(
            device
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        logits = model(
            batch
        )

        targets = build_batch_targets(
            batch
        )

        loss = compute_batch_loss(
            logits,
            batch,
            targets
        )

        assert torch.isfinite(
            loss
        )

        loss.backward()

        torch.nn.utils.clip_grad_norm_(
            model.parameters(),
            max_norm=5.0
        )

        optimizer.step()

        total_loss += (
            float(loss.detach().cpu())
            * batch.num_graphs
        )

        graph_count += (
            batch.num_graphs
        )

    return (
        total_loss
        / graph_count
    )


@torch.no_grad()
def evaluate(
    model,
    loader,
    device
):

    model.eval()

    total_loss = 0.0
    graph_count = 0

    for batch in loader:

        batch = batch.to(
            device
        )

        logits = model(
            batch
        )

        targets = build_batch_targets(
            batch
        )

        loss = compute_batch_loss(
            logits,
            batch,
            targets
        )

        assert torch.isfinite(
            loss
        )

        total_loss += (
            float(loss.detach().cpu())
            * batch.num_graphs
        )

        graph_count += (
            batch.num_graphs
        )

    return (
        total_loss
        / graph_count
    )


