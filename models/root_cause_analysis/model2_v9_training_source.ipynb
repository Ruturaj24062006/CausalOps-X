# ----------------------------------------------------------------------------------------------------
# 4. DETERMINISTIC MATCHING FUNCTION
# ----------------------------------------------------------------------------------------------------

def classify_column(
    column,
    nodes
):

    text = str(
        column
    )

    lower = text.lower()

    # Longest node name first.
    candidate_nodes = sorted(
        nodes,
        key=lambda x: len(
            str(x)
        ),
        reverse=True
    )

    matched_node = None

    for node in candidate_nodes:

        node_text = str(
            node
        ).lower()

        if (
            lower == node_text
            or node_text in lower
        ):

            matched_node = node
            break

    if matched_node is None:
        return None, None

    # Longest family first.
    candidate_families = sorted(
        metric_families,
        key=len,
        reverse=True
    )

    matched_family = None

    for family in candidate_families:

        if family.lower() in lower:

            matched_family = family
            break

    return (
        matched_node,
        matched_family
    )

