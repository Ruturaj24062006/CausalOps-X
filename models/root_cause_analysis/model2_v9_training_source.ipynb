print("=" * 100)

for display_name, data in system_data.items():

    X = data["matrix"]
    feature_names = data["feature_names"]

    n_cases, n_features = X.shape

    finite_mask = np.isfinite(X)

    availability = finite_mask.mean(axis=0)

    variances = np.zeros(
        n_features,
        dtype=np.float64
    )

    for j in range(n_features):

        values = X[
            finite_mask[:, j],
            j
        ]

        if len(values) == 0:
            variances[j] = 0.0

        else:
            variances[j] = np.var(values)

    available_mask = (
        availability >= availability_threshold
    )

    nonzero_variance_mask = (
        variances > zero_variance_tolerance
    )

    nearzero_mask = (
        (variances > zero_variance_tolerance)
        &
        (variances <= near_zero_variance_tolerance)
    )

    candidate_mask = (
        available_mask
        &
        nonzero_variance_mask
    )

    candidate_indices = np.where(
        candidate_mask
    )[0]

    candidate_names = [
        feature_names[i]
        for i in candidate_indices
    ]

    print("\n" + "-" * 80)
    print(display_name)
    print("-" * 80)

    print("Cases:", n_cases)
    print("Total features:", n_features)

    print(
        "Available in >= "
        f"{availability_threshold * 100:.0f}% cases:",
        int(available_mask.sum())
    )

    print(
        "Zero variance:",
        int(
            (variances <= zero_variance_tolerance).sum()
        )
    )

    print(
        "Near-zero variance:",
        int(nearzero_mask.sum())
    )

    print(
        "Candidate features:",
        len(candidate_names)
    )

    candidate_contract["systems"][display_name] = {

        "case_count":
            int(n_cases),

        "raw_feature_count":
            int(n_features),

        "availability_threshold":
            availability_threshold,

        "candidate_feature_count":
            int(len(candidate_names)),

        "candidate_feature_indices":
            [int(x) for x in candidate_indices],

        "candidate_feature_names":
            candidate_names,

        "availability":
            {
                feature_names[i]:
                    float(availability[i])
                for i in candidate_indices
            },

        "variance":
            {
                feature_names[i]:
                    float(variances[i])
                for i in candidate_indices
            },
    }


