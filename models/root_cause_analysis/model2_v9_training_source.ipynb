contract_services = {
    system: set(
        contract[
            "system_services"
        ][system]
    )
    for system in SYSTEMS
}

unknown_endpoint_edges = []

for case, edges in case_edges.items():

    system = case_system.get(
        case
    )

    if system not in contract_services:

        continue

    known_services = (
        contract_services[
            system
        ]
    )

    for edge in edges:

        source = edge[
            "source_service"
        ]

        target = edge[
            "target_service"
        ]

        if source not in known_services:

            unknown_endpoint_edges.append({
                "case": case,
                "endpoint": "source",
                "service": source,
                "target": target,
            })

        if target not in known_services:

            unknown_endpoint_edges.append({
                "case": case,
                "endpoint": "target",
                "service": target,
                "source": source,
            })

