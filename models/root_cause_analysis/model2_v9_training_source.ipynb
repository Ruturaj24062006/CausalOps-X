def find_system_entry(obj, system_name):

    if isinstance(obj, dict):

        if system_name in obj:
            return obj[system_name]

        normalized = (
            system_name.lower()
            .replace(" ", "_")
            .replace("-", "_")
        )

        for key, value in obj.items():

            key_norm = (
                str(key)
                .lower()
                .replace(" ", "_")
                .replace("-", "_")
            )

            if key_norm == normalized:
                return value

        for value in obj.values():

            result = find_system_entry(
                value,
                system_name
            )

            if result is not None:
                return result

    elif isinstance(obj, list):

        for item in obj:

            result = find_system_entry(
                item,
                system_name
            )

            if result is not None:
                return result

    return None


def extract_feature_names(entry):

    if isinstance(entry, dict):

        for key in [
            "feature_names",
            "node_feature_names",
            "features",
            "names",
        ]:

            value = entry.get(key)

            if (
                isinstance(value, list)
                and all(isinstance(x, str) for x in value)
            ):
                return value

        for value in entry.values():

            result = extract_feature_names(value)

            if result is not None:
                return result

    elif isinstance(entry, list):

        if all(isinstance(x, str) for x in entry):
            return entry

        for item in entry:

            result = extract_feature_names(item)

            if result is not None:
                return result

    return None


