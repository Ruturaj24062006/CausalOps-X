class Model2V9Corrected(torch.nn.Module):

    def __init__(
        self,
        node_input_dim=32,
        edge_input_dim=5,
        hidden_dim=128,
        dropout=0.2
    ):

        super().__init__()

        self.conv1 = GCNConv(
            node_input_dim,
            hidden_dim
        )

        self.conv2 = GCNConv(
            hidden_dim,
            hidden_dim
        )

        self.conv3 = GCNConv(
            hidden_dim,
            hidden_dim
        )

        self.dropout = torch.nn.Dropout(
            dropout
        )

        self.score_head = torch.nn.Linear(
            hidden_dim,
            1
        )

    def forward_with_intermediates(
        self,
        data
    ):

        x = data.x
        edge_index = data.edge_index

        layer1_pre_relu = self.conv1(
            x,
            edge_index
        )

        layer1_post_relu = torch.relu(
            layer1_pre_relu
        )

        layer2_pre_relu = self.conv2(
            layer1_post_relu,
            edge_index
        )

        layer2_post_relu = torch.relu(
            layer2_pre_relu
        )

        layer3_pre_relu = self.conv3(
            layer2_post_relu,
            edge_index
        )

        # IMPORTANT:
        # NO ReLU after layer 3.
        layer3_post_relu = layer3_pre_relu

        score = self.score_head(
            layer3_post_relu
        )

        return {
            "raw": x,
            "layer1_pre_relu": layer1_pre_relu,
            "layer1_post_relu": layer1_post_relu,
            "layer2_pre_relu": layer2_pre_relu,
            "layer2_post_relu": layer2_post_relu,
            "layer3_pre_relu": layer3_pre_relu,
            "layer3_post_relu": layer3_post_relu,
            "score": score
        }

    def forward(
        self,
        data
    ):

        return self.forward_with_intermediates(
            data
        )["score"]


model = Model2V9Corrected()

