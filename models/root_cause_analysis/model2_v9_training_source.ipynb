print("14. FINAL HELD-OUT TEST EVALUATION")
print("=" * 100)


with torch.no_grad():

    for batch in test_loader:

        # Complete batch moved to device.
        # Graph tensors remain CPU until batching.

        batch = batch.to(device)

        logits = model(batch)

        assert logits.ndim == 2
        assert logits.shape[0] == batch.x.shape[0]
        assert logits.shape[1] == 1

        ptr = batch.ptr

        for graph_idx in range(
            batch.num_graphs
        ):

            start = int(
                ptr[graph_idx]
            )

            end = int(
                ptr[graph_idx + 1]
            )

            scores = logits[
                start:end,
                0
            ]

            case_id = str(
                batch.case_id[
                    graph_idx
                ]
            )

            system = str(
                batch.system[
                    graph_idx
                ]
            )

            target = int(
                target_by_case[
                    case_id
                ]
            )

            num_nodes = (
                end - start
            )

            assert (
                0 <= target < num_nodes
            )

            order = torch.argsort(
                scores,
                descending=True
            )

            predicted = int(
                order[0].item()
            )

            target_position = (
                order == target
            ).nonzero(
                as_tuple=False
            )

            assert (
                target_position.numel()
                == 1
            )

            rank = int(
                target_position.item()
                + 1
            )

            # Graph-local CrossEntropyLoss
            graph_loss = criterion(
                scores.unsqueeze(0),
                torch.tensor(
                    [target],
                    dtype=torch.long,
                    device=device
                )
            )

            total_loss += (
                graph_loss.item()
            )

            total_graphs += 1

            ranks.append(rank)

            if rank <= 1:
                top1 += 1

            if rank <= 3:
                top3 += 1

            if rank <= 5:
                top5 += 1

            stats = system_stats[
                system
            ]

            stats["graphs"] += 1
            stats["ranks"].append(rank)

            if rank <= 1:
                stats["top1"] += 1

            if rank <= 3:
                stats["top3"] += 1

            if rank <= 5:
                stats["top5"] += 1

            prediction_records.append({
                "case_id": case_id,
                "system": system,
                "target_node": target,
                "predicted_node": predicted,
                "rank": rank,
                "num_nodes": num_nodes,
            })


