# ================================================================================================

print("\n" + "=" * 100)
print("10. FROZEN VALIDATION EVALUATION")
print("=" * 100)

with torch.no_grad():

    for batch in validation_loader:

        batch = batch.to(
            device
        )

        logits = model(
            batch
        )

        assert logits.shape[1] == 1
        assert torch.isfinite(
            logits
        ).all()

        targets = build_targets(
            batch
        )

        node_start = 0

        batch_loss = 0.0

        for graph_index in range(
            batch.num_graphs
        ):

            node_count = int(
                (
                    batch.batch
                    == graph_index
                ).sum().item()
            )

            node_end = (
                node_start
                + node_count
            )

            graph_logits = logits[
                node_start:node_end
            ].reshape(
                1,
                node_count
            )

            target = targets[
                graph_index
            ]

            loss = criterion(
                graph_logits,
                target.reshape(1)
            )

            batch_loss += (
                float(loss)
            )

            scores = logits[
                node_start:node_end,
                0
            ]

            ranking = torch.argsort(
                scores,
                descending=True
            )

            target_int = int(
                target.item()
            )

            pred_top1 = int(
                ranking[0].item()
            )

            pred_top3 = set(
                ranking[
                    :min(3, node_count)
                ].tolist()
            )

            pred_top5 = set(
                ranking[
                    :min(5, node_count)
                ].tolist()
            )

            top1 = (
                pred_top1
                == target_int
            )

            top3 = (
                target_int
                in pred_top3
            )

            top5 = (
                target_int
                in pred_top5
            )

            if top1:
                top1_correct += 1

            if top3:
                top3_correct += 1

            if top5:
                top5_correct += 1

            system = batch.system[
                graph_index
            ]

            system_stats[
                system
            ]["total"] += 1

            if top1:
                system_stats[
                    system
                ]["top1"] += 1

            if top3:
                system_stats[
                    system
                ]["top3"] += 1

            if top5:
                system_stats[
                    system
                ]["top5"] += 1

            predictions.append(
                {
                    "case_id":
                        batch.case_id[
                            graph_index
                        ],

                    "system":
                        system,

                    "target_node":
                        target_int,

                    "predicted_node":
                        pred_top1,

                    "top1":
                        bool(top1),

                    "top3":
                        bool(top3),

                    "top5":
                        bool(top5),

                    "node_count":
                        node_count
                }
            )

            node_start = node_end

        total_loss += batch_loss
        total_graphs += batch.num_graphs


