import os
import re
import json
from pathlib import Path

SEARCH_ROOTS = [
    "/kaggle/working",
    "/kaggle/input"
]

OUTPUT_DIR = "/kaggle/working/model2_v9_source_recovery"
os.makedirs(OUTPUT_DIR, exist_ok=True)

patterns = [
    r"node_features\s*=",
    r"node_feature_names\s*=",
    r"edge_features\s*=",
    r"edge_feature_names\s*=",
    r"edge_attr\s*=",
    r"edge_index\s*=",
    r"service_to_node\s*=",
    r"node_to_service\s*=",
    r"node_mapping\s*=",
    r"feature_names\s*=",
    r"StandardScaler",
    r"fit_transform",
    r"\.transform\(",
    r"torch_geometric",
    r"GCNConv",
    r"Data\(",
    r"forward\s*\(",
    r"root_node_index",
    r"target_node_index",
    r"metrics\.parquet",
    r"traces\.parquet",
    r"inject_time\.txt",
    r"model2_v9"
]

compiled = [re.compile(p, re.IGNORECASE) for p in patterns]

matches = []

allowed_extensions = {
    ".py",
    ".ipynb",
    ".txt",
    ".json",
    ".yaml",
    ".yml",
    ".md",
    ".csv"
}

for root in SEARCH_ROOTS:

    if not os.path.exists(root):
        continue

    for dirpath, dirnames, filenames in os.walk(root):

        dirnames[:] = [
            d for d in dirnames
            if d not in {
                ".cache",
                "__pycache__",
                ".git",
                "node_modules"
            }
        ]

        for filename in filenames:

            path = os.path.join(dirpath, filename)

            if Path(filename).suffix.lower() not in allowed_extensions:
                continue

            try:

                size = os.path.getsize(path)

                # Skip very large files
                if size > 20 * 1024 * 1024:
                    continue

                with open(
                    path,
                    "r",
                    encoding="utf-8",
                    errors="ignore"
                ) as f:
                    text = f.read()

                file_matches = []

                for line_number, line in enumerate(
                    text.splitlines(),
                    start=1
                ):

                    for pattern, regex in zip(
                        patterns,
                        compiled
                    ):

                        if regex.search(line):

                            file_matches.append({
                                "line": line_number,
                                "pattern": pattern,
                                "text": line[:500]
                            })

                if file_matches:

                    matches.append({
                        "file": path,
                        "size": size,
                        "matches": file_matches
                    })

            except Exception:
                pass


# ------------------------------------------------------------
# SAVE MATCH INDEX
# ------------------------------------------------------------

index_path = os.path.join(
    OUTPUT_DIR,
    "step3_v9_source_match_index.json"
)

with open(
    index_path,
    "w",
    encoding="utf-8"
) as f:

    json.dump(
        matches,
        f,
        indent=2
    )


# ------------------------------------------------------------
# EXTRACT SOURCE CONTEXT
# ------------------------------------------------------------

context_path = os.path.join(
    OUTPUT_DIR,
    "step3_v9_source_context.txt"
)

with open(
    context_path,
    "w",
    encoding="utf-8"
) as out:

    for item in matches:

        out.write("\n")
        out.write("=" * 100 + "\n")
        out.write("FILE: " + item["file"] + "\n")
        out.write("=" * 100 + "\n")

        try:

            with open(
                item["file"],
                "r",
                encoding="utf-8",
                errors="ignore"
            ) as f:
                lines = f.readlines()

            selected = set()

            for match in item["matches"]:

                line_no = match["line"]

                start = max(1, line_no - 10)
                end = min(len(lines), line_no + 10)

                for n in range(start, end + 1):
                    selected.add(n)

            for n in sorted(selected):

                out.write(
                    f"{n:6d}: "
                    f"{lines[n-1].rstrip()}\n"
                )

        except Exception as e:

            out.write(
                "ERROR: " + str(e) + "\n"
            )


