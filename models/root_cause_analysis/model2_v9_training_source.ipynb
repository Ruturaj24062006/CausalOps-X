    case = record["case"]

    path = os.path.join(
        ROOT,
        case,
        "metrics.parquet"
    )

    df = pd.read_parquet(path)

    for column in df.columns:

        service, family = parse_metric_column(
            column
        )

        if service is not None:

            system_services[
                system
            ].add(service)

for system in SYSTEMS:

    services = sorted(
        system_services[system]
