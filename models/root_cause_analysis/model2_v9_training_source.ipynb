    )

# ----------------------------------------------------------------------------------------------------
# DETERMINISTIC METRIC COLUMN MATCHING
# ----------------------------------------------------------------------------------------------------

def classify_metric_column(
    column_name,
    nodes
):

    text = str(
        column_name
    )

    lower = text.lower()

    # Longest node name first to prevent
    # partial-name collisions.

    candidate_nodes = sorted(
        nodes,
        key=lambda x: len(str(x)),
        reverse=True
    )

    matched_node = None

    for node in candidate_nodes:

        node_lower = str(
            node
        ).lower()

        if (
            lower == node_lower
            or node_lower in lower
        ):

            matched_node = node
            break

    if matched_node is None:
        return None, None

    # Family matching.
    #
    # Longer / more specific families first.
    #
    family_candidates = sorted(
        metric_families,
        key=len,
        reverse=True
    )

    matched_family = None

    for family in family_candidates:

        if family.lower() in lower:

            matched_family = family
            break

    return (
        matched_node,
        matched_family
    )

