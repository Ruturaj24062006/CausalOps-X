import re
import pandas as pd
from collections import defaultdict

print("=" * 100)
print("CAUSALOPS X — MODEL 2 V9")
print("STEP 6C — METRIC + TRACE SERVICE RECONCILIATION")
print("=" * 100)

# ----------------------------------------------------------------------------------------------------
# SAFETY
# ----------------------------------------------------------------------------------------------------

print("""
================================================================================
SAFETY
================================================================================

THIS IS AN INSPECTION / RECONCILIATION STEP ONLY.

NO TRAINING.
NO FEATURE SELECTION.
NO FEATURE REDUCTION.
NO GRAPH CONSTRUCTION.
NO MODEL MODIFICATION.
NO CHECKPOINT MODIFICATION.

NO EDGES WILL BE CREATED.

best_model_v8.pth WILL NOT BE TOUCHED.
================================================================================
""")

ROOT = "/kaggle/working/rcaeval_re2"
OUTPUT = "/kaggle/working/model2_v9_step6c_service_reconciliation.json"

assert os.path.isdir(ROOT), f"RE2 dataset not found: {ROOT}"

# ----------------------------------------------------------------------------------------------------
# 1. CASE DISCOVERY
# ----------------------------------------------------------------------------------------------------

cases = sorted([
    x for x in os.listdir(ROOT)
    if os.path.isdir(os.path.join(ROOT, x))
    and x.startswith("re2")
])

print("=" * 100)
print("1. CASE INVENTORY")
print("=" * 100)

print("Total cases:", len(cases))

assert len(cases) == 270, f"Expected 270 RE2 cases, found {len(cases)}"

# ----------------------------------------------------------------------------------------------------
# 2. SYSTEM IDENTIFICATION
# ----------------------------------------------------------------------------------------------------

def identify_system(case_name):
    if case_name.startswith("re2ob_"):
        return "Online Boutique"
    if case_name.startswith("re2ss_"):
        return "Sock Shop"
    if case_name.startswith("re2tt_"):
        return "Train Ticket"
    return "UNKNOWN"

system_cases = defaultdict(list)

for case in cases:
    system_cases[identify_system(case)].append(case)

for system in ["Online Boutique", "Sock Shop", "Train Ticket", "UNKNOWN"]:
    print(f"{system:20s}: {len(system_cases[system])}")

assert len(system_cases["UNKNOWN"]) == 0

# ----------------------------------------------------------------------------------------------------
# 3. METRIC SERVICE DISCOVERY
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("3. METRIC SERVICE DISCOVERY")
print("=" * 100)

metric_services_by_system = defaultdict(set)
metric_read_failures = []

for idx, case in enumerate(cases, 1):

    path = os.path.join(ROOT, case, "metrics.parquet")

    try:
        df = pd.read_parquet(path)
    except Exception as e:
        metric_read_failures.append({
            "case": case,
            "error": str(e)
        })
        continue

    system = identify_system(case)

    # Detect service-oriented metric column prefixes.
    # This intentionally does NOT invent mappings.
    columns = [str(c) for c in df.columns]

    for col in columns:

        # Common metric naming pattern:
        # service_metric
        #
        # We only use the prefix when the column actually follows
        # a known metric-family structure.

        parts = col.split("_")

        if len(parts) >= 2:
            candidate = parts[0]

            # Avoid treating generic fields as services.
            if candidate.lower() not in {
                "timestamp",
                "time",
                "value",
                "metric",
                "labels"
            }:
                metric_services_by_system[system].add(candidate)

    if idx % 25 == 0 or idx == len(cases):
        print(f"Processed metrics: {idx}/{len(cases)}")

# ----------------------------------------------------------------------------------------------------
# 4. TRACE SERVICE DISCOVERY
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("4. TRACE SERVICE DISCOVERY")
print("=" * 100)

trace_services_by_system = defaultdict(set)
trace_read_failures = []
trace_missing_cases = []

for idx, case in enumerate(cases, 1):

    path = os.path.join(ROOT, case, "traces.parquet")

    if not os.path.exists(path):
        trace_missing_cases.append(case)
        continue

    try:
        df = pd.read_parquet(path)
    except Exception as e:
        trace_read_failures.append({
            "case": case,
            "error": str(e)
        })
        continue

    system = identify_system(case)

    if "serviceName" in df.columns:
        values = (
            df["serviceName"]
            .dropna()
            .astype(str)
            .str.strip()
        )

        trace_services_by_system[system].update(
            x for x in values.unique()
            if x
        )

    if idx % 25 == 0 or idx == len(cases):
        print(f"Processed traces: {idx}/{len(cases)}")

# ----------------------------------------------------------------------------------------------------
# 5. SERVICE INVENTORY COMPARISON
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("5. SERVICE INVENTORY COMPARISON")
print("=" * 100)

result = {
    "systems": {},
    "metric_read_failures": metric_read_failures,
    "trace_read_failures": trace_read_failures,
    "trace_missing_cases": trace_missing_cases
}

for system in ["Online Boutique", "Sock Shop", "Train Ticket"]:

    metric_services = sorted(metric_services_by_system[system])
    trace_services = sorted(trace_services_by_system[system])

    metric_set = set(metric_services)
    trace_set = set(trace_services)

    union = sorted(metric_set | trace_set)
    intersection = sorted(metric_set & trace_set)

    metric_only = sorted(metric_set - trace_set)
    trace_only = sorted(trace_set - metric_set)

    print(f"\n--- {system} ---")

    print("Metric services:", len(metric_services))
    print("Trace services :", len(trace_services))
    print("Union         :", len(union))
    print("Intersection  :", len(intersection))
    print("Metric only   :", len(metric_only))
    print("Trace only    :", len(trace_only))

    print("\nMetric services:")
    for x in metric_services:
        print(" ", x)

    print("\nTrace services:")
    for x in trace_services:
        print(" ", x)

    print("\nTrace-only services:")
    for x in trace_only:
        print(" ", x)

    print("\nMetric-only services:")
    for x in metric_only:
        print(" ", x)

    result["systems"][system] = {
        "metric_services": metric_services,
        "trace_services": trace_services,
        "union_services": union,
        "intersection_services": intersection,
        "metric_only_services": metric_only,
        "trace_only_services": trace_only
    }

# ----------------------------------------------------------------------------------------------------
# 6. GLOBAL SERVICE INVENTORY
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("6. GLOBAL SERVICE INVENTORY")
print("=" * 100)

global_metric_services = sorted(
    set().union(
        *[set(v) for v in metric_services_by_system.values()]
    )
)

global_trace_services = sorted(
    set().union(
        *[set(v) for v in trace_services_by_system.values()]
    )
)

global_union = sorted(
    set(global_metric_services) |
    set(global_trace_services)
)

print("Global metric services:", len(global_metric_services))
print("Global trace services :", len(global_trace_services))
print("Global union          :", len(global_union))

print("\nGlobal trace-only services:")

global_trace_only = sorted(
    set(global_trace_services) - set(global_metric_services)
)

for service in global_trace_only:
    print(" ", service)

print("\nGlobal metric-only services:")

global_metric_only = sorted(
    set(global_metric_services) - set(global_trace_services)
)

for service in global_metric_only:
    print(" ", service)

# ----------------------------------------------------------------------------------------------------
# 7. EDGE ENDPOINT COMPATIBILITY
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("7. RECOVERED EDGE ENDPOINT COMPATIBILITY")
print("=" * 100)

# Read Step 6B audit if available.
STEP6B = "/kaggle/working/model2_v9_step6b_parent_span_graph_audit.json"

edge_pairs = set()
edge_endpoint_services = set()

if os.path.exists(STEP6B):

    with open(STEP6B, "r", encoding="utf-8") as f:
        audit6b = json.load(f)

    # Recursively search dictionaries/lists for service relationship records.
    def collect_edges(obj):

        if isinstance(obj, dict):

            source = obj.get("source")
            target = obj.get("target")

            if isinstance(source, str) and isinstance(target, str):
                if source and target:
                    edge_pairs.add((source, target))
                    edge_endpoint_services.add(source)
                    edge_endpoint_services.add(target)

            for value in obj.values():
                collect_edges(value)

        elif isinstance(obj, list):
            for item in obj:
                collect_edges(item)

    collect_edges(audit6b)

print("Recovered edge relationships discovered:", len(edge_pairs))

unknown_edge_services = sorted(
    edge_endpoint_services - set(global_union)
)

print("Edge endpoint services:", len(edge_endpoint_services))
print("Unknown edge endpoint services:", len(unknown_edge_services))

for service in unknown_edge_services:
    print(" ", service)

# ----------------------------------------------------------------------------------------------------
# 8. TRACE-MISSING SYSTEM IMPACT
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("8. TRACE-MISSING SYSTEM IMPACT")
print("=" * 100)

for system in ["Online Boutique", "Sock Shop", "Train Ticket"]:

    total = len(system_cases[system])

    missing = sum(
        1 for case in system_cases[system]
        if case in set(trace_missing_cases)
    )

    print(
        f"{system:20s}: "
        f"{total-missing}/{total} trace available | "
        f"{missing} missing"
    )

# ----------------------------------------------------------------------------------------------------
# 9. FINAL RECONCILIATION CONTRACT
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("9. FINAL RECONCILIATION CONTRACT")
print("=" * 100)

print("""
The canonical graph node inventory will NOT be finalized in this step.

This step only establishes the evidence required for the next contract.

Rules:

1. A service may enter the graph node inventory only if observed in
   the recovered metric/trace evidence.

2. No service name will be manually invented.

3. Every future graph edge endpoint MUST exist in the canonical node inventory.

4. Trace-only services MUST NOT automatically receive metric features.

5. Metric-only services MUST NOT automatically receive trace edges.

6. Sock Shop trace-missing cases MUST remain explicitly identified.

7. No edges will be fabricated for trace-missing cases.

8. The final node ordering will be deterministic and frozen only after
   this reconciliation is validated.
""")

# ----------------------------------------------------------------------------------------------------
# 10. SAVE RESULT
# ----------------------------------------------------------------------------------------------------

result["global"] = {
    "metric_services": global_metric_services,
    "trace_services": global_trace_services,
    "union_services": global_union,
    "metric_only_services": global_metric_only,
    "trace_only_services": global_trace_only,
    "edge_endpoint_services": sorted(edge_endpoint_services),
    "unknown_edge_endpoint_services": unknown_edge_services
}

result["summary"] = {
    "total_cases": len(cases),
    "trace_available_cases": len(cases) - len(trace_missing_cases),
    "trace_missing_cases": len(trace_missing_cases),
    "global_metric_service_count": len(global_metric_services),
    "global_trace_service_count": len(global_trace_services),
    "global_union_service_count": len(global_union),
    "edge_relationship_count": len(edge_pairs),
    "unknown_edge_endpoint_service_count": len(unknown_edge_services)
}

with open(OUTPUT, "w", encoding="utf-8") as f:
    json.dump(result, f, indent=2)

# ----------------------------------------------------------------------------------------------------
# 11. RESULT
# ----------------------------------------------------------------------------------------------------

print("\n" + "=" * 100)
print("STEP 6C RESULT")
print("=" * 100)

print("Total cases:", len(cases))
print("Trace-missing cases:", len(trace_missing_cases))
print("Global metric services:", len(global_metric_services))
print("Global trace services:", len(global_trace_services))
print("Global union services:", len(global_union))
