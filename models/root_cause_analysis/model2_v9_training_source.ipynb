def inspect_structure(obj, path="ROOT", depth=0, max_depth=5):

    indent = "  " * depth

    if depth > max_depth:
        return

    if isinstance(obj, dict):

        print(
            f"{indent}{path}: dict "
            f"({len(obj)} keys)"
        )

        for key, value in obj.items():

            child_path = f"{path}.{key}"

            if isinstance(value, dict):

                inspect_structure(
                    value,
                    child_path,
                    depth + 1,
                    max_depth
                )

            elif isinstance(value, list):

                print(
                    f"{'  ' * (depth + 1)}"
                    f"{child_path}: list "
                    f"(length={len(value)})"
                )

                if len(value) > 0:

                    first = value[0]

                    print(
                        f"{'  ' * (depth + 2)}"
                        f"first item type="
                        f"{type(first).__name__}"
                    )

                    if isinstance(first, dict):

                        print(
                            f"{'  ' * (depth + 2)}"
                            f"first item keys="
                            f"{list(first.keys())}"
                        )

            else:

                print(
                    f"{'  ' * (depth + 1)}"
                    f"{child_path}: "
                    f"{type(value).__name__} = "
                    f"{repr(value)[:150]}"
                )

    elif isinstance(obj, list):

        print(
            f"{indent}{path}: list "
            f"(length={len(obj)})"
        )

        if len(obj) > 0:

            first = obj[0]

            print(
                f"{indent}  first item type="
                f"{type(first).__name__}"
            )

