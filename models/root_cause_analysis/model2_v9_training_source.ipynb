NO CHECKPOINT MODIFICATION.

Edges will ONLY be created from actual parentSpanID relationships.

NO EDGES WILL BE INVENTED.

best_model_v8.pth WILL NOT BE TOUCHED.
""")

# =============================================================================
# 1. LOAD INPUTS
# =============================================================================

with open(AUDIT_PATH, "r", encoding="utf-8") as f:
    audit = json.load(f)

with open(CONTRACT_PATH, "r", encoding="utf-8") as f:
    contract = json.load(f)

