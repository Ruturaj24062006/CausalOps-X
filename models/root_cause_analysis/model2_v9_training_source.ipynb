    flat_x = matrix[case_index]

    assert flat_x.shape == (
        node_count * 32,
    )

    assert np.isfinite(
        flat_x
    ).all()

    x = flat_x.reshape(
        node_count,
        32
    )

    # ------------------------------------------------------------------
    # EXACT STEP 8 TOPOLOGY
    # ------------------------------------------------------------------

    topology_entry = case_graphs[
        case_id
    ]

    assert (
        topology_entry["system"]
        == system
    )

    topology_edges = (
        topology_entry["edges"]
    )

    topology_edge_count = (
        topology_entry["edge_count"]
    )

    assert (
        len(topology_edges)
        == topology_edge_count
    )

    # ------------------------------------------------------------------
    # EXACT STEP 9 EDGE RECORDS
    # ------------------------------------------------------------------

    feature_entry = case_edge_features[
        case_id
    ]

    assert (
        feature_entry["system"]
        == system
    )

    feature_edges = (
        feature_entry["edges"]
    )

    assert (
        len(feature_edges)
        == len(topology_edges)
    ), (
        f"Edge count mismatch: {case_id}"
    )

    edge_index_rows = []
    edge_feature_rows = []

    # ------------------------------------------------------------------
    # USE EXISTING NODE INDICES
    # ------------------------------------------------------------------

    for edge_number, (
        topology_edge,
        feature_edge
    ) in enumerate(
        zip(
            topology_edges,
            feature_edges
        )
    ):

        # --------------------------------------------------------------
        # Step 8 source / target
        # --------------------------------------------------------------

        assert (
            "source_node"
            in topology_edge
        )

        assert (
            "target_node"
            in topology_edge
        )

        source_node = int(
            topology_edge[
                "source_node"
            ]
        )

        target_node = int(
            topology_edge[
                "target_node"
            ]
        )

        # --------------------------------------------------------------
        # Step 9 source / target
        # --------------------------------------------------------------

        assert (
            "source_node"
            in feature_edge
        )

        assert (
            "target_node"
            in feature_edge
        )

        feature_source_node = int(
            feature_edge[
                "source_node"
            ]
        )

        feature_target_node = int(
            feature_edge[
                "target_node"
            ]
        )

        assert (
            source_node
            ==
            feature_source_node
        ), (
            f"Source node mismatch: "
            f"{case_id}, edge {edge_number}"
        )

        assert (
            target_node
            ==
            feature_target_node
        ), (
            f"Target node mismatch: "
            f"{case_id}, edge {edge_number}"
        )

        # --------------------------------------------------------------
        # Validate node indices
        # --------------------------------------------------------------

        assert (
            0
            <= source_node
            < node_count
        )

        assert (
            0
            <= target_node
            < node_count
        )

        # --------------------------------------------------------------
        # EXISTING Step 9 feature vector
        # --------------------------------------------------------------

        assert (
            "feature_vector"
            in feature_edge
        )

        feature_vector = np.asarray(
            feature_edge[
                "feature_vector"
            ],
            dtype=np.float32
        )

        assert feature_vector.shape == (
            5,
        )

        assert np.isfinite(
            feature_vector
        ).all()

        # --------------------------------------------------------------
        # Cross-check dictionary representation
        # --------------------------------------------------------------

        assert (
            "features"
            in feature_edge
        )

        feature_dict = (
            feature_edge["features"]
        )

        assert isinstance(
            feature_dict,
            dict
        )

        expected_vector = np.asarray(
            [
                feature_dict[
                    "call_count"
                ],
                feature_dict[
                    "mean_duration"
                ],
                feature_dict[
                    "std_duration"
                ],
                feature_dict[
                    "error_rate"
                ],
                feature_dict[
                    "p90_duration"
                ],
            ],
            dtype=np.float32
        )

        assert np.allclose(
            feature_vector,
            expected_vector,
            rtol=1e-6,
            atol=1e-6
        )

        # --------------------------------------------------------------
        # Add EXACT existing edge
        # --------------------------------------------------------------

        edge_index_rows.append(
            [
                source_node,
                target_node
            ]
        )

        edge_feature_rows.append(
            feature_vector
        )

    # ------------------------------------------------------------------
    # PyG tensors
    # ------------------------------------------------------------------

    x_tensor = torch.tensor(
        x,
        dtype=torch.float32
    )

    if edge_index_rows:

        edge_index = torch.tensor(
            np.asarray(
                edge_index_rows,
                dtype=np.int64
            ).T,
            dtype=torch.long
        )

        edge_attr = torch.tensor(
            np.asarray(
                edge_feature_rows,
                dtype=np.float32
            ),
            dtype=torch.float32
        )

    else:

        edge_index = torch.empty(
            (2, 0),
            dtype=torch.long
        )

        edge_attr = torch.empty(
            (0, 5),
            dtype=torch.float32
        )

    # ------------------------------------------------------------------
    # Graph validation
    # ------------------------------------------------------------------

    assert x_tensor.shape == (
        node_count,
        32
    )

    assert edge_index.shape[0] == 2

    assert edge_index.shape[1] == (
        edge_attr.shape[0]
    )

    assert edge_attr.shape[1] == 5

    assert torch.isfinite(
        x_tensor
    ).all()

    assert torch.isfinite(
        edge_attr
    ).all()

    if edge_index.numel() > 0:

        assert int(
            edge_index.min()
        ) >= 0

        assert int(
            edge_index.max()
        ) < node_count

    # ------------------------------------------------------------------
    # Create graph
    # ------------------------------------------------------------------

    data = Data(
        x=x_tensor,
        edge_index=edge_index,
        edge_attr=edge_attr
    )

    data.case_id = case_id
    data.system = system

    graphs.append(data)

    system_graph_counts[
        system
    ] += 1

    system_edge_counts[
        system
    ] += edge_index.shape[1]

    if (
        graph_number % 25 == 0
        or graph_number == 270
    ):

        print(
            f"Constructed "
            f"{graph_number}/270"
        )


