print("12. FROZEN VALIDATION EVALUATION")
print("=" * 100)


with torch.no_grad():

    for batch in validation_loader:

        batch = batch.to(device)

        logits = model(batch)

        assert logits.ndim == 2
        assert logits.shape[0] == batch.x.shape[0]
        assert logits.shape[1] == 1

        targets = build_local_targets(
            batch
        )

        batch_loss = []

        ptr = batch.ptr

        for graph_idx in range(
            batch.num_graphs
        ):

            start = int(
                ptr[graph_idx]
            )

            end = int(
                ptr[graph_idx + 1]
            )

            scores = logits[
                start:end,
                0
            ]

            target = int(
                targets[
                    graph_idx
                ]
            )

            loss_i = criterion(
                scores.unsqueeze(0),
                torch.tensor(
                    [target],
                    dtype=torch.long,
                    device=device
                )
            )

            batch_loss.append(
                loss_i
            )

            order = torch.argsort(
                scores,
                descending=True
            )

            rank = int(
                (
                    order == target
                )
                .nonzero(
                    as_tuple=False
                )
                .item()
                + 1
            )

            predicted = int(
                order[0].item()
            )

            case_id = str(
                batch.case_id[
                    graph_idx
                ]
            )

            system = str(
                batch.system[
                    graph_idx
                ]
            )

            ranks.append(rank)

            total_graphs += 1

            if rank <= 1:
                top1 += 1

            if rank <= 3:
                top3 += 1

            if rank <= 5:
                top5 += 1

            stats = system_stats[
                system
            ]

            stats["graphs"] += 1
            stats["ranks"].append(rank)

            if rank <= 1:
                stats["top1"] += 1

            if rank <= 3:
                stats["top3"] += 1

            if rank <= 5:
                stats["top5"] += 1

            prediction_records.append({
                "case_id": case_id,
                "system": system,
                "target_node": target,
                "predicted_node": predicted,
                "rank": rank,
                "num_nodes": end - start,
            })

        batch_loss_value = torch.stack(
            batch_loss
        ).mean().item()

        total_loss += (
            batch_loss_value
            * batch.num_graphs
        )


validation_loss = (
