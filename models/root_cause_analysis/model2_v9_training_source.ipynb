def tensor_statistics(x):

    x = x.detach().float()

    assert torch.isfinite(x).all()

    if x.ndim == 1:

        x = x.view(-1, 1)

    dimension_std = x.std(
        dim=0,
        unbiased=False
    )

    dimension_zero_variance = int(
        (
            dimension_std <= 1e-12
        ).sum().item()
    )

    return {

        "shape": list(x.shape),

        "mean": float(
            x.mean().item()
        ),

        "std": float(
            x.std(
                unbiased=False
            ).item()
        ),

        "min": float(
            x.min().item()
        ),

        "max": float(
            x.max().item()
        ),

        "mean_dimension_std": float(
            dimension_std.mean().item()
        ),

        "zero_variance_dimensions": (
            dimension_zero_variance
        ),

        "finite": True
    }


